<ui:FluentWindow
    x:Class="WslVision.Views.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    Title="WSL Vision · Configuração inicial"
    Icon="pack://application:,,,/Assets/app.ico"
    Width="1040"
    Height="720"
    MinWidth="820"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
    ExtendsContentIntoTitleBar="True"
    Background="{StaticResource Wv.Bg}"
    WindowBackdropType="None"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="CheckRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="16,14" />
        </Style>
        <Style x:Key="OkIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="CheckmarkCircle24" />
            <Setter Property="Filled" Value="True" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="MissingIcon" TargetType="ui:SymbolIcon" BasedOn="{StaticResource OkIcon}">
            <Setter Property="Symbol" Value="Warning24" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="WSL Vision · Configuração inicial" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Etapas  -->
            <StackPanel Grid.Column="0" Margin="0,8,24,0">
                <TextBlock Margin="12,0,0,12" Style="{StaticResource Caption}" Text="{Binding StepLabel}" />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SetupStep}">
                            <Button
                                MinHeight="52"
                                Margin="0,0,0,4"
                                Padding="12,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Height="Auto"
                                Style="{StaticResource BtnGhost}"
                                Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsReachable}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="26" Height="26" Margin="0,0,12,0">
                                        <Ellipse x:Name="Circle" Fill="Transparent" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1" />
                                        <TextBlock x:Name="Num" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Number}" />
                                        <ui:SymbolIcon x:Name="Done" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Symbol="Checkmark24" Visibility="Collapsed" />
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="StepTitle" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                    <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Done" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Done" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    <Setter TargetName="Num" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Done" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Conteúdo da etapa  -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Border Padding="32,16" Background="{DynamicResource SubtleFillColorTertiaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,8,8" DockPanel.Dock="Bottom">
                        <DockPanel LastChildFill="False">
                            <Button Style="{StaticResource BtnSecondary}" Command="{Binding BackCommand}" Content="Voltar" DockPanel.Dock="Left" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding FinishCommand}" Content="Abrir o painel" DockPanel.Dock="Right" Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding NextCommand}" Content="Continuar" DockPanel.Dock="Right" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                       Visibility="{Binding IsNotLastStep, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="{Binding IsBusy}" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding BusyText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,28">
                            <ui:InfoBar Margin="0,0,0,16" IsClosable="True" IsOpen="{Binding Error, Converter={StaticResource NotNull}, Mode=OneWay}" Message="{Binding Error}" Severity="Error" Title="Algo deu errado" />

                            <!--  0: Distro  -->
                            <StackPanel Visibility="{Binding IsStep0, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Qual distro o app vai controlar?" />
                                <TextBlock Margin="0,6,0,18" Style="{StaticResource Secondary}" Text="Encontramos estas distros no WSL. Escolha a que tem, ou vai ter, o Docker Engine." />
                                <ItemsControl ItemsSource="{Binding Distros}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DistroOption}">
                                            <RadioButton
                                                Margin="0,0,0,8"
                                                Padding="8,10"
                                                Command="{Binding DataContext.SelectDistroCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                GroupName="Distro"
                                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                IsEnabled="{Binding IsSelectable}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Info}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:InfoBar Margin="0,8,0,0" IsClosable="False" IsOpen="{Binding NoDistros}" Severity="Error" Title="Nenhuma distro WSL 2 encontrada."
                                            Message="Instale o Debian pela Microsoft Store ou com o comando wsl --install -d Debian e abra o app de novo." />
                                <ui:InfoBar Margin="0,8,0,0" IsClosable="False" IsOpen="{Binding DockerDesktopDetected}" Severity="Warning" Title="O Docker Desktop também está instalado."
                                            Message="Ele roda um engine próprio e pode disputar o comando docker com a sua distro. Recomendamos desligar a integração do Docker Desktop com essa distro (Settings › Resources › WSL integration)." />
                            </StackPanel>

                            <!--  1: Docker Engine  -->
                            <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Docker Engine na distro" />
                                <TextBlock Margin="0,6,0,18" Style="{StaticResource Secondary}" Text="Verificamos o que já está pronto." />
                                <Border Style="{StaticResource CardBorder}" Visibility="{Binding Status, Converter={StaticResource NullToVis}}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource CheckRow}">
                                            <Grid DockPanel.Dock="Left">
                                                <ui:SymbolIcon Style="{StaticResource OkIcon}" Visibility="{Binding Status.DockerInstalled, Converter={StaticResource BoolToVis}}" />
                                                <ui:SymbolIcon Style="{StaticResource MissingIcon}" Visibility="{Binding Status.DockerInstalled, Converter={StaticResource InverseBoolToVis}}" />
                                            </Grid>
                                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding InstallDockerCommand}" Content="Instalar Docker Engine" DockPanel.Dock="Right"
                                                       Visibility="{Binding Status.DockerInstalled, Converter={StaticResource InverseBoolToVis}}" />
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="Docker Engine instalado" />
                                                <TextBlock Style="{StaticResource Caption}" Text="Sem ele, o assistente abre um terminal com o instalador oficial (get.docker.com). Você acompanha cada passo e digita a senha do sudo." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                                        <DockPanel Style="{StaticResource CheckRow}">
                                            <Grid DockPanel.Dock="Left">
                                                <ui:SymbolIcon Style="{StaticResource OkIcon}" Visibility="{Binding Status.SystemdActive, Converter={StaticResource BoolToVis}}" />
                                                <ui:SymbolIcon Style="{StaticResource MissingIcon}" Visibility="{Binding Status.SystemdActive, Converter={StaticResource InverseBoolToVis}}" />
                                            </Grid>
                                            <Button Style="{StaticResource BtnSecondary}" Command="{Binding EnableSystemdCommand}" Content="Ativar systemd" DockPanel.Dock="Right"
                                                       Visibility="{Binding Status.SystemdActive, Converter={StaticResource InverseBoolToVis}}" />
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="systemd ativado" />
                                                <TextBlock Style="{StaticResource Caption}" Text="Com o systemd (no /etc/wsl.conf), o Docker sobe sozinho junto com a distro." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                                        <DockPanel Style="{StaticResource CheckRow}">
                                            <ui:ToggleSwitch AutomationProperties.Name="Ligar o Docker junto com a distro" DockPanel.Dock="Right" IsChecked="{Binding AutoStartDocker}" IsEnabled="{Binding Status.SystemdActive}" />
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="Ligar o Docker junto com a distro" />
                                                <TextBlock Style="{StaticResource Caption}" Text="Desligado (recomendado): o Docker só liga quando você pedir, e projetos não sobem sem necessidade. Dá para mudar depois em Ajustes." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding DetectCommand}" Style="{StaticResource BtnGhost}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Symbol="ArrowSync24" />
                                        <TextBlock VerticalAlignment="Center" Text="Verificar de novo" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!--  2: Permissões  -->
                            <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Usar o Docker sem sudo" />
                                <TextBlock Margin="0,6,0,18" Style="{StaticResource Secondary}">
                                    <Run Text="Colocamos o usuário " /><Run FontWeight="SemiBold" Text="{Binding User, Mode=OneWay}" />
                                    <Run Text=" no grupo docker. Depois disso, nem você nem o app precisam de sudo ou de abrir o WSL como administrador." />
                                </TextBlock>
                                <Border Padding="16" Style="{StaticResource CardBorder}" Visibility="{Binding Status.UserInDockerGroup, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,8,0" Symbol="LockClosed24" />
                                            <TextBlock Text="Este passo roda uma vez como root dentro da distro:" />
                                        </StackPanel>
                                        <Border Margin="0,10" Padding="12,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                            <TextBlock Style="{StaticResource Mono}" Text="{Binding GroupCommand}" />
                                        </Border>
                                        <Button HorizontalAlignment="Left" Style="{StaticResource BtnPrimary}" Command="{Binding AddToGroupCommand}" Content="Permitir e adicionar ao grupo" />
                                    </StackPanel>
                                </Border>
                                <ui:InfoBar IsClosable="False" IsOpen="{Binding Status.UserInDockerGroup, FallbackValue=False}" Severity="Success" Title="Pronto."
                                            Message="O usuário faz parte do grupo docker. Se acabou de ser adicionado, a distro é reiniciada ao continuar para aplicar." />
                            </StackPanel>

                            <!--  3: Conexão  -->
                            <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Como o app fala com o Docker" />
                                <TextBlock Margin="0,6,0,18" Style="{StaticResource Secondary}" Text="Você pode trocar isso depois em Ajustes." />
                                <RadioButton Margin="0,0,0,8" Padding="8,10" GroupName="Conn" IsChecked="{Binding UseSocket}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="Socket local do Docker" />
                                            <Border Margin="8,0,0,0" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" Style="{StaticResource Pill}">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Recomendado" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="Nenhuma porta de rede fica aberta. O app fala com /var/run/docker.sock por dentro do WSL." />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Margin="0,0,0,16" Padding="8,10" GroupName="Conn" IsChecked="{Binding UseTcp}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="API TCP em 127.0.0.1:2375" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Mais simples, mas qualquer programa deste PC passa a poder controlar o Docker sem senha." />
                                    </StackPanel>
                                </RadioButton>
                                <ui:Button HorizontalAlignment="Left" Appearance="Secondary" Command="{Binding TestCommand}" Content="Testar conexão" Icon="{ui:SymbolIcon PlugConnected24}" />
                                <ui:InfoBar Margin="0,16,0,0" IsClosable="False" IsOpen="{Binding TestOk}" Message="{Binding TestContainers}" Severity="Success" Title="{Binding TestMessage}" />
                                <ui:InfoBar Margin="0,16,0,0" IsClosable="False" IsOpen="{Binding TestFailed}" Message="{Binding TestMessage}" Severity="Error" Title="Sem conexão" />
                            </StackPanel>

                            <!--  4: Pronto  -->
                            <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,0,0,18" Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,14,0" FontSize="40" Style="{StaticResource OkIcon}" />
                                    <StackPanel>
                                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Tudo pronto" />
                                        <TextBlock Style="{StaticResource Secondary}" Text="A distro e o Docker já aparecem no painel." />
                                    </StackPanel>
                                </StackPanel>
                                <Border Margin="0,0,0,16" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource CheckRow}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedDistro}" />
                                            <TextBlock Style="{StaticResource Secondary}" Text="Distro" />
                                        </DockPanel>
                                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                                        <DockPanel Style="{StaticResource CheckRow}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionName}" />
                                            <TextBlock Style="{StaticResource Secondary}" Text="Conexão" />
                                        </DockPanel>
                                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                                        <DockPanel Style="{StaticResource CheckRow}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GroupSummary}" />
                                            <TextBlock Style="{StaticResource Secondary}" Text="Docker sem sudo" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <DockPanel Margin="0,0,0,12">
                                    <ui:ToggleSwitch AutomationProperties.Name="Iniciar com o Windows" DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows}" />
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Iniciar com o Windows" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Abre minimizado, só o ícone na bandeja" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Tudo o que o assistente alterou pode ser desfeito em Ajustes › O que o app alterou." />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
