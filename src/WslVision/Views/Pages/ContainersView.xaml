<UserControl
    x:Class="WslVision.Views.Pages.ContainersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:layout="clr-namespace:WslVision.Views.Layout"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ContainersViewModel}"
    PreviewKeyDown="OnPreviewKeyDown"
    mc:Ignorable="d">

    <!--  Um cartão por projeto do Compose; serviços em linhas; logs num painel ao lado (a lista continua visível)  -->
    <UserControl.Resources>
        <!--
            Colunas da tabela, pela largura da lista (que perde espaço quando os logs abrem):
            larga (≥ 940) mostra tudo; média tira "ligado há" e CPU; compacta tira também porta e memória, e o status vira só o ponto.
        -->
        <Style x:Key="CellStatus" TargetType="Border">
            <Setter Property="Width" Value="112" />
            <Style.Triggers>
                <Trigger Property="layout:Responsive.Size" Value="Compact">
                    <Setter Property="Width" Value="28" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellPort" TargetType="Border" BasedOn="{StaticResource HideCompact}">
            <Setter Property="Width" Value="130" />
        </Style>
        <Style x:Key="CellUptime" TargetType="Border" BasedOn="{StaticResource WideOnly}">
            <Setter Property="Width" Value="170" />
        </Style>
        <Style x:Key="CellCpu" TargetType="Border" BasedOn="{StaticResource WideOnly}">
            <Setter Property="Width" Value="96" />
        </Style>
        <Style x:Key="CellMem" TargetType="Border" BasedOn="{StaticResource HideCompact}">
            <Setter Property="Width" Value="104" />
        </Style>

        <Style x:Key="MiniBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Margin" Value="0,4,12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{StaticResource Wv.Track}" CornerRadius="2" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource Wv.Accent}" CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Selo de status do projeto (texto + ponto, nunca só a cor)  -->
        <Style x:Key="GroupPill" TargetType="Border">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource ToneSoft}}" />
            <Setter Property="TextElement.Foreground" Value="{Binding Status, Converter={StaticResource ToneBrush}}" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Cabeçalho: título e resumo à esquerda; busca, filtro e a ação principal à direita (embaixo, no estreito)  -->
        <layout:SplitPanel Grid.Row="0" Margin="0,0,0,16" Spacing="16" StackBelow="980">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="Containers" />
                <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource Wv.Text2}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding State.IsStartingEnvironment, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="{Binding State.IsStartingEnvironment}" />
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Wv.Text2}" Text="{Binding State.EnvironmentStep}" />
                </StackPanel>
                <ui:TextBox
                    x:Name="SearchBox"
                    Width="260"
                    Height="34"
                    Margin="0,0,8,0"
                    Padding="8,6"
                    AutomationProperties.Name="Buscar containers (Ctrl+F)"
                    ClearButtonEnabled="True"
                    FontSize="13"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Buscar serviço, imagem ou projeto"
                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding State.IsDockerUp, Converter={StaticResource BoolToVis}}" />
                <Border Margin="0,0,8,0" Padding="3" Background="{StaticResource Wv.Surface}" BorderBrush="#26282D" BorderThickness="1" CornerRadius="9"
                        Visibility="{Binding State.IsDockerUp, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Filter" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" Style="{StaticResource SegmentItem}">
                            <TextBlock FontSize="13"><Run Text="Todos " /><Run Foreground="{StaticResource Wv.Text3}" Text="{Binding CountAll, Mode=OneWay}" /></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="Filter" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Running}" Style="{StaticResource SegmentItem}">
                            <TextBlock FontSize="13"><Run Text="Rodando " /><Run Foreground="{StaticResource Wv.Text3}" Text="{Binding CountRunning, Mode=OneWay}" /></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="Filter" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Stopped}" Style="{StaticResource SegmentItem}">
                            <TextBlock FontSize="13"><Run Text="Parados " /><Run Foreground="{StaticResource Wv.Text3}" Text="{Binding CountStopped, Mode=OneWay}" /></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="Filter" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Error}" Style="{StaticResource SegmentItem}">
                            <TextBlock FontSize="13"><Run Text="Com erro " /><Run Foreground="{StaticResource Wv.Text3}" Text="{Binding CountError, Mode=OneWay}" /></TextBlock>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Button Command="{Binding Env.StartCommand}" IsEnabled="{Binding State.IsStartingEnvironment, Converter={StaticResource InverseBool}}"
                        AutomationProperties.HelpText="Liga a distro, o Docker e os projetos marcados para iniciar junto"
                        Style="{StaticResource BtnPrimary}" ToolTip="Liga a distro, o Docker e os projetos marcados com “Com o ambiente”"
                        Visibility="{Binding Env.NeedsStart, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Filled="True" Symbol="Play24" />
                        <TextBlock VerticalAlignment="Center" Text="Iniciar ambiente" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </layout:SplitPanel>

        <!--  Lista e logs lado a lado; sem largura para os dois, os logs descem para baixo da lista  -->
        <layout:SplitPanel Grid.Row="1" SecondWidth="440" Spacing="16" StackBelow="980" StackedFirstHeight="3*" StackedSecondHeight="2*">
            <Grid>
    
                <!--  Estados: distro desligada, Docker desligado, carregando, vazio  -->
                <Border Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource EmptyState}" Visibility="{Binding State.IsDistroOff, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="36" Foreground="{StaticResource Wv.Text3}" Symbol="Power24" />
                        <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="A distro está desligada" />
                        <TextBlock MaxWidth="440" HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="O app não liga a distro sozinho, para não ocupar memória sem você pedir." TextAlignment="Center" />
                        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding Env.StartCommand}" Content="Iniciar ambiente" Style="{StaticResource BtnPrimary}" ToolTip="Distro, Docker e os projetos marcados, de uma vez" />
                            <Button Command="{Binding StartDistroCommand}" Content="Só ligar a distro" Style="{StaticResource BtnSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource EmptyState}" Visibility="{Binding State.IsDockerOff, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="36" Foreground="{StaticResource Wv.Text3}" Symbol="Box24" />
                        <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="O Docker está desligado" />
                        <TextBlock MaxWidth="440" HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="Ligue o serviço para ver e controlar seus containers. A distro continua rodando normalmente." TextAlignment="Center" />
                        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding Env.StartCommand}" Content="Iniciar ambiente" Style="{StaticResource BtnPrimary}" ToolTip="Docker e os projetos marcados, de uma vez" />
                            <Button Command="{Binding ToggleDockerCommand}" Content="Só ligar o Docker" Style="{StaticResource BtnSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ui:ProgressRing Grid.Column="0" Margin="0,48,0,0" VerticalAlignment="Top" IsIndeterminate="{Binding State.HasCheckedOnce, Converter={StaticResource InverseBool}}" Visibility="{Binding State.HasCheckedOnce, Converter={StaticResource InverseBoolToVis}}" />
                <ui:ProgressRing Grid.Column="0" Margin="0,48,0,0" VerticalAlignment="Top" IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <Border Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource EmptyState}" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="36" Foreground="{StaticResource Wv.Text3}" Symbol="Box24" />
                        <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="{Binding EmptyTitle}" />
                        <TextBlock MaxWidth="440" HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding EmptyText}" TextAlignment="Center" />
                        <Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}" Content="Limpar filtros" Style="{StaticResource BtnSecondary}"
                                Visibility="{Binding IsTotallyEmpty, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </Border>
    
                <!--  Projetos  -->
                <ScrollViewer Grid.Column="0" layout:Responsive.CompactBelow="640" layout:Responsive.MediumBelow="940" layout:Responsive.Track="True" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                    <ItemsControl Margin="0,0,10,0" ItemsSource="{Binding Groups}" KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ContainerGroupViewModel}">
                                <Border Margin="0,0,0,12" Style="{StaticResource CardBorder}" TextElement.Foreground="{StaticResource Wv.Text}">
                                    <StackPanel>
                                        <!--  Cabeçalho do projeto  -->
                                        <!--  Sem largura para tudo numa linha, as ações descem para baixo do nome  -->
                                        <DockPanel Margin="8,12,14,12">
                                            <Button Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Top" DockPanel.Dock="Left"
                                                    AutomationProperties.Name="{Binding Title, StringFormat=Recolher ou expandir {0}}"
                                                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnIcon}">
                                                <ui:SymbolIcon x:Name="Chevron" FontSize="13" Symbol="ChevronDown24" />
                                            </Button>
                                            <layout:SplitPanel Spacing="14" StackBelow="720">
                                                <StackPanel VerticalAlignment="Center">
                                                    <!--  O selo vem logo depois do nome; o nome é que encurta quando falta espaço  -->
                                                    <DockPanel HorizontalAlignment="Left">
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource GroupPill}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                                                                <TextBlock VerticalAlignment="Center" Text="{Binding StatusLabel}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,2,0,0" FontFamily="{StaticResource Wv.Mono}" FontSize="12" Foreground="{StaticResource Wv.Text3}" Text="{Binding WorkingDirLabel}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkingDir}" Visibility="{Binding HasWorkingDir, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <Border Margin="0,0,14,0" VerticalAlignment="Center" Style="{StaticResource WideOnly}">
                                                        <TextBlock FontSize="13" Foreground="{StaticResource Wv.Text2}">
                                                            <Run FontWeight="SemiBold" Foreground="{StaticResource Wv.Text}" Text="{Binding CpuText, Mode=OneWay}" /><Run Text=" CPU   " /><Run FontWeight="SemiBold" Foreground="{StaticResource Wv.Text}" Text="{Binding MemText, Mode=OneWay}" /><Run Text=" RAM" />
                                                        </TextBlock>
                                                    </Border>
                                                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                                    <Button Height="32" Margin="0,0,4,0" Style="{StaticResource BtnGhost}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat=Abrir o projeto {0} no VS Code}" ToolTip="{Binding WorkingDir}"
                                                            Command="{Binding DataContext.Inventory.OpenGroupInVsCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding HasWorkingDir, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon FontSize="14" Symbol="Code24" />
                                                            <Border Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource HideCompact}">
                                                                <TextBlock Text="VS Code" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Height="32" Margin="0,0,8,0" Style="{StaticResource BtnGhost}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat=Abrir terminal na pasta do projeto {0}}" ToolTip="Terminal na pasta do projeto"
                                                            Command="{Binding DataContext.OpenGroupTerminalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding HasWorkingDir, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon FontSize="14" Symbol="WindowConsole20" />
                                                            <Border Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource HideCompact}">
                                                                <TextBlock Text="Terminal" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Height="32" Margin="0,0,6,0" Content="Reiniciar" Style="{StaticResource BtnSecondary}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat=Reiniciar todos os containers de {0}}"
                                                            Command="{Binding DataContext.Inventory.RestartGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding AnyRunning, Converter={StaticResource BoolToVis}}" />
                                                    <Button Height="32" Margin="0,0,6,0" Content="Parar tudo" Style="{StaticResource BtnSecondary}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat=Parar todos os containers de {0}}"
                                                            Command="{Binding DataContext.Inventory.StopGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding AnyRunning, Converter={StaticResource BoolToVis}}" />
                                                    <Button Height="32" Margin="0,0,6,0" Style="{StaticResource BtnPrimary}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat=Iniciar o projeto {0}}" ToolTip="Sobe os containers na ordem do depends_on"
                                                            Command="{Binding DataContext.Inventory.StartGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding AnyRunning, Converter={StaticResource InverseBoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="12" Filled="True" Symbol="Play24" />
                                                            <TextBlock VerticalAlignment="Center" Text="Iniciar projeto" />
                                                        </StackPanel>
                                                    </Button>
                                                    <StackPanel Margin="6,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding IsCompose, Converter={StaticResource BoolToVis}}">
                                                        <ui:ToggleSwitch AutomationProperties.Name="{Binding Title, StringFormat=Iniciar {0} com o ambiente}"
                                                                         Command="{Binding DataContext.Inventory.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                         IsChecked="{Binding IsStartup, Mode=OneWay}" ToolTip="O botão Iniciar ambiente também sobe este projeto" />
                                                        <Border Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource HideCompact}">
                                                            <TextBlock FontSize="12" Foreground="{StaticResource Wv.Text2}" Text="Com o ambiente" />
                                                        </Border>
                                                    </StackPanel>
                                                </WrapPanel>
                                            </layout:SplitPanel>
                                        </DockPanel>
    
                                        <!--  Serviços  -->
                                        <StackPanel x:Name="Rows">
                                            <Grid Margin="48,0,14,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" MinWidth="160" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="128" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CellStatus}">
                                                    <Border Style="{StaticResource HideCompact}">
                                                        <TextBlock Style="{StaticResource ColumnHeader}" Text="STATUS" />
                                                    </Border>
                                                </Border>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="SERVIÇO" />
                                                <Border Grid.Column="2" Style="{StaticResource CellPort}">
                                                    <TextBlock Style="{StaticResource ColumnHeader}" Text="PORTA" />
                                                </Border>
                                                <Border Grid.Column="3" Style="{StaticResource CellUptime}">
                                                    <TextBlock Style="{StaticResource ColumnHeader}" Text="LIGADO HÁ" />
                                                </Border>
                                                <Border Grid.Column="4" Style="{StaticResource CellCpu}">
                                                    <TextBlock Style="{StaticResource ColumnHeader}" Text="CPU" />
                                                </Border>
                                                <Border Grid.Column="5" Style="{StaticResource CellMem}">
                                                    <TextBlock Style="{StaticResource ColumnHeader}" Text="MEMÓRIA" />
                                                </Border>
                                                <TextBlock Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="AÇÕES" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ContainerItemViewModel}">
                                                        <!--  Linha acessível: Tab chega até ela, Enter abre os logs, Delete exclui, Shift+F10 abre o menu  -->
                                                        <Border
                                                            x:Name="Row"
                                                            AutomationProperties.HelpText="Enter abre os logs. Shift+F10 mostra as ações."
                                                            AutomationProperties.Name="{Binding AccessibleName}"
                                                            Background="Transparent"
                                                            BorderBrush="{StaticResource Wv.Divider}"
                                                            BorderThickness="0,1,0,0"
                                                            Cursor="Hand"
                                                            Focusable="True"
                                                            FocusVisualStyle="{StaticResource RoundFocusVisual}"
                                                            KeyboardNavigation.IsTabStop="True"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            ToolTip="{Binding Name}">
                                                            <Border.InputBindings>
                                                                <MouseBinding Command="{Binding DataContext.ShowLogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="LeftClick" />
                                                                <KeyBinding Command="{Binding DataContext.ShowLogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Key="Enter" />
                                                                <KeyBinding Command="{Binding DataContext.ShowLogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Key="Space" />
                                                                <KeyBinding Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Key="Delete" />
                                                            </Border.InputBindings>
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Command="{Binding PlacementTarget.Tag.ShowLogsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Ver logs" Icon="{ui:SymbolIcon DocumentText24}" InputGestureText="Enter" />
                                                                    <MenuItem Command="{Binding PlacementTarget.Tag.OpenPortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Abrir no navegador" Icon="{ui:SymbolIcon Open24}"
                                                                              Visibility="{Binding PortUrl, Converter={StaticResource NullToVis}}" />
                                                                    <Separator />
                                                                    <MenuItem Command="{Binding PlacementTarget.Tag.StartCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Iniciar" Icon="{ui:SymbolIcon Play24}"
                                                                              Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVis}}" />
                                                                    <MenuItem Command="{Binding PlacementTarget.Tag.RestartCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Reiniciar" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                                                              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                                    <MenuItem Command="{Binding PlacementTarget.Tag.StopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Parar" Icon="{ui:SymbolIcon Stop24}"
                                                                              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                                    <Separator />
                                                                    <MenuItem Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Foreground="{StaticResource Wv.Red}" Header="Excluir…" Icon="{ui:SymbolIcon Delete24}" InputGestureText="Del" />
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <Grid MinHeight="48" Margin="48,0,14,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" MinWidth="160" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="128" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CellStatus}" ToolTip="{Binding StatusLabel}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource ToneBrush}}" />
                                                                        <Border Style="{StaticResource HideCompact}">
                                                                            <TextBlock FontSize="13" Foreground="{Binding Status, Converter={StaticResource ToneBrush}}" Text="{Binding StatusLabel}" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock FontSize="12" Foreground="{StaticResource Wv.Text3}" Text="{Binding Image}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CellPort}">
                                                                    <Grid>
                                                                        <TextBlock Visibility="{Binding PortUrl, Converter={StaticResource NullToVis}}">
                                                                            <Hyperlink Command="{Binding DataContext.OpenPortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                                       FontFamily="{StaticResource Wv.Mono}" FontSize="12" Foreground="{StaticResource Wv.AccentText}" TextDecorations="None">
                                                                                <Run Text="{Binding PortText, Mode=OneWay}" />
                                                                            </Hyperlink>
                                                                        </TextBlock>
                                                                        <TextBlock Foreground="{StaticResource Wv.TextFaint}" Text="{Binding PortText}" Visibility="{Binding PortUrl, Converter={StaticResource InverseNullToVis}}" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource CellUptime}">
                                                                    <TextBlock Margin="0,0,8,0" FontSize="13" Foreground="{StaticResource Wv.Text2}" Text="{Binding Uptime}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Uptime}" />
                                                                </Border>
                                                                <Border Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource CellCpu}">
                                                                    <StackPanel>
                                                                        <TextBlock FontSize="12" Text="{Binding CpuText}" />
                                                                        <ProgressBar Style="{StaticResource MiniBar}" Value="{Binding CpuShare, Mode=OneWay}" AutomationProperties.Name="CPU" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource CellMem}">
                                                                    <StackPanel>
                                                                        <TextBlock FontSize="12" Text="{Binding MemText}" />
                                                                        <ProgressBar Style="{StaticResource MiniBar}" Value="{Binding MemShare, Mode=OneWay}" AutomationProperties.Name="Memória" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                                                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,6,0" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                                                    <Button AutomationProperties.Name="Logs" Style="{StaticResource BtnIcon}" ToolTip="Logs (Enter)"
                                                                            Command="{Binding DataContext.ShowLogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                        <ui:SymbolIcon FontSize="16" Symbol="TextAlignLeft24" />
                                                                    </Button>
                                                                    <Button AutomationProperties.Name="Reiniciar" Style="{StaticResource BtnIcon}" ToolTip="Reiniciar"
                                                                            Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                                        <ui:SymbolIcon FontSize="16" Symbol="ArrowClockwise24" />
                                                                    </Button>
                                                                    <Button AutomationProperties.Name="Parar" Style="{StaticResource BtnIcon}" ToolTip="Parar"
                                                                            Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                                        <ui:SymbolIcon FontSize="14" Filled="True" Symbol="Stop24" />
                                                                    </Button>
                                                                    <Button AutomationProperties.Name="Iniciar" Foreground="{StaticResource Wv.Green}" Style="{StaticResource BtnIcon}" ToolTip="Iniciar"
                                                                            Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                            Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVis}}">
                                                                        <ui:SymbolIcon FontSize="14" Filled="True" Symbol="Play24" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Wv.Hover}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Wv.Selected}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                        <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Chevron" Property="Symbol" Value="ChevronRight24" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
    
            </Grid>

            <!--  Logs: painel lateral, a lista continua visível  -->
            <Border
                Style="{StaticResource CardBorder}"
                TextElement.Foreground="{StaticResource Wv.Text}"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel Margin="16,12,8,12" DockPanel.Dock="Top">
                        <Button AutomationProperties.Name="Fechar logs" Command="{Binding CloseLogsCommand}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" Width="36" Height="36">
                            <ui:SymbolIcon FontSize="13" Symbol="Dismiss24" />
                        </Button>
                        <Border Height="22" Margin="10,0,6,0" Padding="9,0" VerticalAlignment="Center" CornerRadius="11" DockPanel.Dock="Right">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Wv.GraySoft}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Wv.Text2}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Wv.GreenSoft}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource Wv.Green}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding LiveLabel}" />
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Selected.DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12" Foreground="{StaticResource Wv.Text3}">
                                <Run Text="{Binding Selected.ComposeProject, Mode=OneWay}" /><Run Text=" · logs" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <Border BorderBrush="{StaticResource Wv.Border}" BorderThickness="0,1,0,0" DockPanel.Dock="Top" />
                    <DockPanel Margin="12,10" DockPanel.Dock="Top">
                        <Button Height="32" Margin="6,0,0,0" Command="{Binding CopyLogsCommand}" Content="Copiar" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" />
                        <Button Height="32" Margin="6,0,0,0" Command="{Binding ToggleLogPauseCommand}" Content="{Binding PauseLabel}" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" />
                        <ui:TextBox Height="32" Padding="8,5" AutomationProperties.Name="Filtrar linhas do log" ClearButtonEnabled="True" FontSize="13" Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="Filtrar linhas" Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Border BorderBrush="{StaticResource Wv.Border}" BorderThickness="0,1,0,0" DockPanel.Dock="Top" />
                    <TextBlock Margin="14,8" DockPanel.Dock="Bottom" FontSize="12" Foreground="{StaticResource Wv.Text3}" Text="Últimas 500 linhas · rola sozinho enquanto você estiver no fim" />
                    <Border BorderBrush="{StaticResource Wv.Border}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom" />
                    <ListBox
                        x:Name="LogList"
                        Padding="0,8"
                        AutomationProperties.Name="Linhas de log"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding LogsView}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LogLineViewModel}">
                                <DockPanel>
                                    <TextBlock Width="64" FontFamily="{StaticResource Wv.Mono}" FontSize="12" Foreground="{StaticResource Wv.TextFaint}" Text="{Binding Time}" />
                                    <TextBlock x:Name="Line" FontFamily="{StaticResource Wv.Mono}" FontSize="12" Foreground="{StaticResource Wv.TextSoft}" Text="{Binding Text}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Wv.Red}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </layout:SplitPanel>
    </Grid>
</UserControl>
