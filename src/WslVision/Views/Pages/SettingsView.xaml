<UserControl
    x:Class="WslVision.Views.Pages.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="20,14" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="32,28,32,24" HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,20" Style="{StaticResource PageTitle}" Text="Ajustes" />

            <TextBlock Margin="0,0,0,8" Style="{StaticResource ColumnHeader}" Text="Distro e Docker" />
            <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <ComboBox Width="220" AutomationProperties.Name="Distro principal" DockPanel.Dock="Right" ItemsSource="{Binding Distros}" SelectedItem="{Binding SelectedDistro}" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Distro principal" />
                            <TextBlock Style="{StaticResource Caption}" Text="Onde estão o Docker Engine e os seus arquivos" />
                        </StackPanel>
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <ui:ToggleSwitch AutomationProperties.Name="Usar a API TCP" DockPanel.Dock="Right" IsChecked="{Binding UseTcp}" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Usar a API TCP em 127.0.0.1:2375" />
                            <TextBlock Style="{StaticResource Caption}" Text="Desligado (recomendado): o app fala com o socket do Docker por dentro do WSL e nenhuma porta fica aberta." />
                        </StackPanel>
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Button Style="{StaticResource BtnSecondary}" Command="{Binding RunSetupCommand}" Content="Abrir o assistente" DockPanel.Dock="Right" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Configuração inicial" />
                            <TextBlock Style="{StaticResource Caption}" Text="Verificar o Docker, o systemd e as permissões de novo" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,0,0,8" Style="{StaticResource ColumnHeader}" Text="Inicialização" />
            <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <!--  O que o app liga ao abrir (inclusive com o Windows). Padrão: nada.  -->
                    <StackPanel Margin="20,14,20,10">
                        <TextBlock FontWeight="SemiBold" Text="Ao abrir o WSL Vision" />
                        <TextBlock Margin="0,0,0,8" Style="{StaticResource Caption}" Text="Também vale quando o app abre com o Windows. Quanto menos ligar, menos memória o PC usa até você começar a trabalhar." />
                        <RadioButton Margin="0,4" GroupName="OnLaunch" IsChecked="{Binding OnLaunch, Converter={StaticResource EnumEquals}, ConverterParameter=None}">
                            <StackPanel>
                                <TextBlock Text="Só o WSL Vision (recomendado)" />
                                <TextBlock Style="{StaticResource Caption}" Text="Nada é ligado. A distro e o Docker ligam quando você pedir." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Margin="0,4" GroupName="OnLaunch" IsChecked="{Binding OnLaunch, Converter={StaticResource EnumEquals}, ConverterParameter=Distro}">
                            <StackPanel>
                                <TextBlock Text="Ligar a distro" />
                                <TextBlock Style="{StaticResource Caption}" Text="Pronta para arquivos e terminal, sem o Docker." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Margin="0,4" GroupName="OnLaunch" IsChecked="{Binding OnLaunch, Converter={StaticResource EnumEquals}, ConverterParameter=DistroAndDocker}">
                            <StackPanel>
                                <TextBlock Text="Ligar a distro e o Docker" />
                                <TextBlock Style="{StaticResource Caption}" Text="Sem subir projetos. Containers com restart: always sobem junto com o Docker." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Margin="0,4" GroupName="OnLaunch" IsChecked="{Binding OnLaunch, Converter={StaticResource EnumEquals}, ConverterParameter=Environment}">
                            <StackPanel>
                                <TextBlock Text="Iniciar o ambiente completo" />
                                <TextBlock Style="{StaticResource Caption}" Text="Distro, Docker e os projetos com &quot;Com o ambiente&quot; ligado (na Visão geral ou em Containers)." />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <ui:ToggleSwitch AutomationProperties.Name="Docker liga junto com a distro" DockPanel.Dock="Right" IsChecked="{Binding DockerAutostart}" IsEnabled="{Binding CanChangeDockerAutostart}" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Docker liga junto com a distro" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DockerAutostartNote}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Recomendado: desligado. É uma configuração da distro (systemd), vale mesmo com o app fechado e pode ser desfeita abaixo." />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,0,0,8" Style="{StaticResource ColumnHeader}" Text="Acessibilidade" />
            <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                <DockPanel Style="{StaticResource SettingRow}">
                    <ComboBox MinWidth="290" AutomationProperties.Name="Tamanho da interface" DisplayMemberPath="Label" DockPanel.Dock="Right" ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Tamanho da interface" />
                        <TextBlock Style="{StaticResource Caption}" Text="Aumenta textos e botões. Atalhos: Ctrl+1 a Ctrl+5 trocam de aba, Ctrl+vírgula abre Ajustes, Ctrl+F busca, F5 atualiza, Shift+F10 abre o menu de um item." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Margin="0,0,0,8" Style="{StaticResource ColumnHeader}" Text="Janela e bandeja" />
            <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <ui:ToggleSwitch AutomationProperties.Name="Iniciar com o Windows" DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows}" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Iniciar com o Windows" />
                            <TextBlock Style="{StaticResource Caption}" Text="Abre minimizado, só com o ícone na bandeja" />
                        </StackPanel>
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <ui:ToggleSwitch AutomationProperties.Name="Fechar para a bandeja" DockPanel.Dock="Right" IsChecked="{Binding CloseToTray}" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Fechar a janela mantém o app na bandeja" />
                            <TextBlock Style="{StaticResource Caption}" Text="Para sair de vez, use “Sair do WSL Vision” no menu da bandeja" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,0,0,8" Style="{StaticResource ColumnHeader}" Text="O que o app alterou" />
            <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <ItemsControl Margin="20,14,20,0" ItemsSource="{Binding ChangesLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Checkmark24" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="20,0,20,8" Style="{StaticResource Secondary}" Text="Nenhuma alteração registrada."
                               Visibility="{Binding HasChanges, Converter={StaticResource InverseBoolToVis}}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Button Style="{StaticResource BtnDanger}" Command="{Binding UndoAllCommand}" Content="Desfazer tudo" DockPanel.Dock="Right" IsEnabled="{Binding HasChanges}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Volta a distro e o Windows para como estavam antes do WSL Vision." />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,0,0,8" Style="{StaticResource ColumnHeader}" Text="Sobre" />
            <Border Style="{StaticResource CardBorder}">
                <DockPanel Style="{StaticResource SettingRow}">
                    <Button Style="{StaticResource BtnSecondary}" Command="{Binding OpenSettingsFolderCommand}" Content="Abrir pasta de configurações" DockPanel.Dock="Right" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="WSL Vision " /><Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Text="Painel leve para WSL e Docker Engine. Sem engine próprio e sem processos em segundo plano." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
