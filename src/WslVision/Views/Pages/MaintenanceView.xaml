<UserControl
    x:Class="WslVision.Views.Pages.MaintenanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:layout="clr-namespace:WslVision.Views.Layout"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MaintenanceViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Item limpável: caixa de seleção, nome, explicação e quanto libera  -->
        <DataTemplate x:Key="CleanupRow" DataType="{x:Type vm:CleanupItem}">
            <Border Padding="0,8" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock x:Name="Size" Margin="12,2,0,0" VerticalAlignment="Top" DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding SizeText}" />
                    <CheckBox VerticalAlignment="Top" AutomationProperties.HelpText="{Binding Description}" AutomationProperties.Name="{Binding Title}" IsChecked="{Binding IsChecked}">
                        <StackPanel>
                            <TextBlock x:Name="Title" FontWeight="SemiBold" Text="{Binding Title}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" />
                        </StackPanel>
                    </CheckBox>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Size}" Value="0">
                    <Setter TargetName="Size" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter TargetName="Size" Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24">
            <!--  Cabeçalho  -->
            <DockPanel Margin="0,0,0,20">
                <Button VerticalAlignment="Bottom" Command="{Binding AnalyzeCommand}" DockPanel.Dock="Right" IsEnabled="{Binding CanAnalyze}" Style="{StaticResource BtnSecondary}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Symbol="ArrowSync24" />
                        <TextBlock VerticalAlignment="Center" Text="Analisar de novo" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Manutenção" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="Libere espaço e memória do WSL e do Docker. Nada é apagado sem você ver o que é e confirmar." />
                </StackPanel>
            </DockPanel>

            <!--  Distro desligada: o app não liga sozinho  -->
            <Border Margin="0,0,0,16" Style="{StaticResource EmptyState}" Padding="24,28" Visibility="{Binding CanAnalyze, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="A distro está desligada" />
                    <TextBlock MaxWidth="460" Margin="0,4,0,12" HorizontalAlignment="Center" Style="{StaticResource Secondary}" TextAlignment="Center"
                               Text="Ligue a distro para ver o que dá para limpar. A compactação do disco funciona com ela desligada." />
                    <Button HorizontalAlignment="Center" Command="{Binding StartDistroCommand}" Style="{StaticResource BtnPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,7,0" FontSize="13" Filled="True" Symbol="Play24" />
                            <TextBlock VerticalAlignment="Center" Text="Ligar a distro" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!--  Dois cartões por linha; um embaixo do outro quando não cabem. Docker e distro somem com a distro desligada  -->
            <layout:AdaptiveGrid ColumnSpacing="16" MaxColumns="2" MinColumnWidth="380" RowSpacing="16">

                <!--  Docker  -->
                <Border Padding="18,16" Style="{StaticResource CardBorder}" Visibility="{Binding CanAnalyze, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon Margin="0,0,10,0" DockPanel.Dock="Left" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="BoxMultiple24" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Docker" />
                                <TextBlock Style="{StaticResource Caption}" Text="Imagens, cache e logs que só ocupam espaço" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Secondary}" Text="Ligue o Docker para ver o que dá para limpar."
                                   Visibility="{Binding ShowDocker, Converter={StaticResource InverseBoolToVis}}" />
                        <StackPanel Visibility="{Binding ShowDocker, Converter={StaticResource BoolToVis}}">
                            <ItemsControl Margin="0,8,0,12" ItemTemplate="{StaticResource CleanupRow}" ItemsSource="{Binding DockerItems}" />
                            <Button HorizontalAlignment="Left" Command="{Binding CleanDockerCommand}" Height="34" Style="{StaticResource BtnDanger}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Symbol="Broom24" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding DockerSelectedText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Linux  -->
                <Border Padding="18,16" Style="{StaticResource CardBorder}" Visibility="{Binding CanAnalyze, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon Margin="0,0,10,0" DockPanel.Dock="Left" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Folder24" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Distro, StringFormat=Distro {0}}" />
                                <TextBlock Style="{StaticResource Caption}" Text="Caches e temporários que os programas recriam quando precisam" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl Margin="0,8,0,12" ItemTemplate="{StaticResource CleanupRow}" ItemsSource="{Binding LinuxItems}" />
                        <Button HorizontalAlignment="Left" Command="{Binding CleanLinuxCommand}" Height="34" Style="{StaticResource BtnDanger}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Symbol="Broom24" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding LinuxSelectedText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!--  Memória  -->
                <Border Padding="18,16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon Margin="0,0,10,0" DockPanel.Dock="Left" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="DeveloperBoard24" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Memória" />
                        </DockPanel>
                        <Grid Margin="0,14,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Caption}" Text="VM do WSL no Windows" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding VmmemText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Caption}" Text="Cache de arquivos do Linux" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding PageCacheText}" />
                            </StackPanel>
                        </Grid>
                        <Button HorizontalAlignment="Left" Command="{Binding FreeMemoryCommand}" Height="34" IsEnabled="{Binding CanAnalyze}" Style="{StaticResource BtnSecondary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Symbol="ArrowMinimize24" />
                                <TextBlock VerticalAlignment="Center" Text="Liberar memória agora" />
                            </StackPanel>
                        </Button>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}"
                                   Text="Descarta o cache de arquivos do Linux sem parar nada. Com “Devolver memória ociosa” ligado (Visão geral › Limites do WSL), o vmmemWSL diminui em seguida." />
                    </StackPanel>
                </Border>

                <!--  Disco virtual  -->
                <Border Padding="18,16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon Margin="0,0,10,0" DockPanel.Dock="Left" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="HardDrive20" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Disco virtual" />
                        </DockPanel>
                        <Grid Margin="0,14,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Caption}" Text="Arquivo .vhdx no Windows" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding VhdText}" ToolTip="{Binding VhdPath}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Caption}" Text="Usado dentro do Linux" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding DiskUsedText}" />
                            </StackPanel>
                        </Grid>
                        <Button HorizontalAlignment="Left" Command="{Binding CompactDiskCommand}" Height="34" IsEnabled="{Binding VhdPath, Converter={StaticResource NotNull}}" Style="{StaticResource BtnSecondary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Symbol="Shield24" />
                                <TextBlock VerticalAlignment="Center" Text="Compactar disco" />
                            </StackPanel>
                        </Button>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}"
                                   Text="O .vhdx cresce, mas não encolhe sozinho. Compactar devolve ao C: o espaço livre dentro do Linux; faça depois de limpar. Desliga o WSL e pede permissão de administrador." />
                    </StackPanel>
                </Border>
            </layout:AdaptiveGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
