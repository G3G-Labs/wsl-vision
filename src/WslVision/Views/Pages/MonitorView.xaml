<UserControl
    x:Class="WslVision.Views.Pages.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="Meter" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,16,24">
            <DockPanel Margin="0,0,16,20">
                <ui:Button
                    VerticalAlignment="Bottom"
                    Appearance="Secondary"
                    Command="{Binding ShutdownWslCommand}"
                    Content="Desligar o WSL"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon Power24}"
                    Visibility="{Binding State.IsDistroRunning, Converter={StaticResource BoolToVis}}" />
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Monitoramento" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}" Text="Atualiza a cada 2 s enquanto esta aba está aberta. Nada é lido em segundo plano." />
                </StackPanel>
            </DockPanel>

            <!--  WSL desligado  -->
            <Border Margin="0,0,16,0" Style="{StaticResource EmptyState}" Visibility="{Binding State.IsDistroOff, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Power24" />
                    <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="A distro está desligada" />
                    <TextBlock MaxWidth="460" HorizontalAlignment="Center" Style="{StaticResource Secondary}" TextAlignment="Center"
                               Text="A memória foi devolvida ao Windows. O app não liga a distro sozinho: ela só volta quando você pedir." />
                    <ui:Button Margin="0,16,0,0" HorizontalAlignment="Center" Appearance="Primary" Command="{Binding StartDistroCommand}" Content="Ligar a distro" Icon="{ui:SymbolIcon Play24}" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding State.IsDistroRunning, Converter={StaticResource BoolToVis}}">
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="Memória do WSL" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BigNumber}" Text="{Binding MemUsedText}" />
                                <TextBlock Margin="6,0,0,6" VerticalAlignment="Bottom" Style="{StaticResource Secondary}" Text="{Binding MemTotalText}" />
                            </StackPanel>
                            <ProgressBar AutomationProperties.Name="Memória do WSL em uso" Style="{StaticResource Meter}" Value="{Binding MemPercent, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Em uso dentro da distro" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="CPU do WSL" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BigNumber}" Text="{Binding CpuText}" />
                                <TextBlock Margin="6,0,0,6" VerticalAlignment="Bottom" Style="{StaticResource Secondary}">
                                    <Run Text="de " /><Run Text="{Binding Processors, Mode=OneWay, StringFormat=0}" /><Run Text=" núcleos" />
                                </TextBlock>
                            </StackPanel>
                            <Viewbox Height="34" Margin="0,4,0,2" Stretch="Fill">
                                <Canvas Width="120" Height="40" ToolTip="CPU no último minuto">
                                    <Line X1="0" X2="120" Y1="39.5" Y2="39.5" Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" StrokeThickness="1" />
                                    <Polyline Points="{Binding CpuPoints}" Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="2" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Style="{StaticResource Caption}" Text="Último minuto" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="Disco da distro" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BigNumber}" Text="{Binding DiskUsedText}" />
                                <TextBlock Margin="6,0,0,6" VerticalAlignment="Bottom" Style="{StaticResource Secondary}" Text="usados" />
                            </StackPanel>
                            <ProgressBar AutomationProperties.Name="Disco da distro em uso" Style="{StaticResource Meter}" Value="{Binding DiskPercent, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DiskSizeText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="vmmemWSL no Windows" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BigNumber}" Text="{Binding VmmemText}" />
                                <TextBlock Margin="6,0,0,6" VerticalAlignment="Bottom" Style="{StaticResource Secondary}" Text="reservados" />
                            </StackPanel>
                            <ProgressBar AutomationProperties.Name="Memória reservada pelo vmmemWSL" Style="{StaticResource Meter}" Value="{Binding VmmemPercent, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Memória que o Windows entregou à VM do WSL" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Docker  -->
                    <Border Grid.Column="0" Margin="0,0,16,16" VerticalAlignment="Top" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="18,16">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Margin="0,0,8,0" Appearance="Secondary" Command="{Binding ToggleDockerCommand}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Ligar" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State.IsDockerUp}" Value="True">
                                                        <Setter Property="Content" Value="Parar" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <ui:Button Appearance="Secondary" Command="{Binding RestartDockerCommand}" Content="Reiniciar"
                                               Visibility="{Binding State.IsDockerUp, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Serviço Docker" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Secondary}" Text="{Binding DockerSummary}" />
                                </StackPanel>
                            </DockPanel>
                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                            <StackPanel Margin="18,12,18,16" Visibility="{Binding State.IsDockerUp, Converter={StaticResource BoolToVis}}">
                                <TextBlock Margin="0,0,0,8" Style="{StaticResource ColumnHeader}" Text="Consumo por container" />
                                <TextBlock Style="{StaticResource Caption}" Text="Nenhum container rodando."
                                           Visibility="{Binding HasNoContainers, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding TopContainers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContainerUsageRow}">
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Margin="0,0,12,0" HorizontalAlignment="Right" Text="{Binding Cpu}" />
                                                <ProgressBar Grid.Column="2" Height="6" VerticalAlignment="Center" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="{Binding Memory}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Margin="18,12,18,16" Style="{StaticResource Secondary}" Text="Com o Docker parado, nenhum container consome recursos."
                                       Visibility="{Binding State.IsDockerUp, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!--  Limites do .wslconfig  -->
                    <Border Grid.Column="1" Margin="0,0,16,16" Padding="18,16" VerticalAlignment="Top" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Limites do WSL" />
                            <TextBlock Margin="0,2,0,12" Style="{StaticResource Secondary}" Text="Gravados no .wslconfig da sua pasta do Windows. Um backup é feito antes da primeira alteração." />

                            <!--  Sugestão de acordo com o hardware deste PC  -->
                            <Border Margin="0,0,0,16" Padding="12,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                <DockPanel>
                                    <Button Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding ApplyRecommendedCommand}" DockPanel.Dock="Right"
                                            IsEnabled="{Binding IsRecommended, Converter={StaticResource InverseBool}}" Style="{StaticResource TintAccent}"
                                            ToolTip="Coloca os controles nos valores recomendados. Nada é gravado até você salvar.">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Symbol="Sparkle24" />
                                            <TextBlock VerticalAlignment="Center" Text="Usar recomendado" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding RecommendationTitle}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding RecommendationReason}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryLimitText}" />
                                <TextBlock FontWeight="SemiBold" Text="Memória máxima" />
                            </DockPanel>
                            <Slider
                                Margin="0,6,0,2"
                                AutomationProperties.Name="Memória máxima do WSL em GB"
                                IsSnapToTickEnabled="True"
                                Maximum="{Binding TotalRamGb}"
                                Minimum="1"
                                TickFrequency="1"
                                Value="{Binding MemoryLimitGb}" />
                            <TextBlock Margin="0,0,0,14" Style="{StaticResource Caption}" Text="{Binding RamHint}" />

                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProcessorsText}" />
                                <TextBlock FontWeight="SemiBold" Text="Processadores" />
                            </DockPanel>
                            <Slider
                                Margin="0,6,0,14"
                                AutomationProperties.Name="Processadores do WSL"
                                IsSnapToTickEnabled="True"
                                Maximum="{Binding CpuCount}"
                                Minimum="1"
                                TickFrequency="1"
                                Value="{Binding Processors}" />

                            <DockPanel Margin="0,0,0,16">
                                <ui:ToggleSwitch AutomationProperties.Name="Devolver memória ociosa ao Windows" DockPanel.Dock="Right" IsChecked="{Binding AutoMemoryReclaim}" />
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Devolver memória ociosa ao Windows" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Reduz o vmmemWSL aos poucos quando a distro está ociosa" />
                                </StackPanel>
                            </DockPanel>

                            <ui:InfoBar Margin="0,0,0,12" IsClosable="False" IsOpen="{Binding SavedMessageVisible}" Message="O WSL foi reiniciado com os novos limites." Severity="Success" Title="Salvo." />

                            <WrapPanel>
                                <ui:Button Margin="0,0,8,8" Appearance="Primary" Command="{Binding SaveLimitsCommand}" Content="Salvar e reiniciar o WSL" IsEnabled="{Binding IsDirty}" />
                                <ui:Button Margin="0,0,8,8" Appearance="Secondary" Command="{Binding UndoLimitsCommand}" Content="Desfazer alterações" IsEnabled="{Binding CanUndoConfig}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Para aplicar, o WSL é desligado e ligado de novo. Os containers ficam parados por alguns segundos." />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
