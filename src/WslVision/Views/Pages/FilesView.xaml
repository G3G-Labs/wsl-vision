<UserControl
    x:Class="WslVision.Views.Pages.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:FilesViewModel}"
    mc:Ignorable="d">

    <!--  Atalhos de teclado  -->
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding OpenInVsCodeCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+Shift+V" />
        <KeyBinding Command="{Binding OpenTerminalCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+Shift+T" />
        <KeyBinding Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+Shift+E" />
        <KeyBinding Command="{Binding CopyLinuxPathCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+Shift+C" />
        <KeyBinding Command="{Binding NewFolderCommand}" Gesture="Ctrl+Shift+N" />
        <KeyBinding Command="{Binding RenameCommand}" CommandParameter="{Binding Selected}" Key="F2" />
        <KeyBinding Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" Key="Delete" />
        <KeyBinding Command="{Binding LoadCommand}" Key="F5" />
        <KeyBinding Command="{Binding UpCommand}" Gesture="Alt+Up" />
        <KeyBinding Command="{Binding BackCommand}" Gesture="Alt+Left" />
        <KeyBinding Command="{Binding CopyCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+C" />
        <KeyBinding Command="{Binding CutCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+X" />
        <KeyBinding Command="{Binding PasteCommand}" Gesture="Ctrl+V" />
    </UserControl.InputBindings>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Cabeçalho + ações da pasta atual  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Bottom" DockPanel.Dock="Right">
                <ui:Button Margin="0,0,8,8" Appearance="Primary" Command="{Binding OpenInVsCodeCommand}" Content="Abrir no VS Code" Icon="{ui:SymbolIcon Code24}" ToolTip="Ctrl+Shift+V" />
                <ui:Button Margin="0,0,8,8" Appearance="Secondary" Command="{Binding OpenTerminalCommand}" Content="Terminal aqui" Icon="{ui:SymbolIcon WindowConsole20}" ToolTip="Ctrl+Shift+T" />
                <ui:Button Margin="0,0,8,8" Appearance="Secondary" Command="{Binding OpenInExplorerCommand}" Content="Explorer" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Ctrl+Shift+E" />
                <ui:Button Margin="0,0,4,8" Appearance="Secondary" Command="{Binding CopyLinuxPathCommand}" Content="Copiar caminho" Icon="{ui:SymbolIcon Copy24}" ToolTip="Ctrl+Shift+C" />
                <ui:Button Margin="0,0,0,8" AutomationProperties.Name="Fixar nos favoritos" Command="{Binding ToggleFavoriteCommand}" Style="{StaticResource IconButton}" ToolTip="Fixar nos favoritos e no menu da bandeja">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Filled="{Binding IsFavorite}" Symbol="Star24" />
                    </ui:Button.Icon>
                </ui:Button>
            </WrapPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Style="{StaticResource PageTitle}" Text="Arquivos" />
                <!--  Trilha de pastas  -->
                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:Crumb}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button
                                    Padding="6,2"
                                    Style="{StaticResource SubtleButton}"
                                    Command="{Binding DataContext.GoToCrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding Name}"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="13" />
                                <ui:SymbolIcon Margin="0,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="ChevronRight24" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DockPanel>

        <!--  Barra secundária: navegação e operações  -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <ui:Button AutomationProperties.Name="Voltar" Command="{Binding BackCommand}" Icon="{ui:SymbolIcon ArrowLeft24}" Style="{StaticResource IconButton}" ToolTip="Voltar (Alt+←)" />
            <ui:Button AutomationProperties.Name="Pasta acima" Command="{Binding UpCommand}" Icon="{ui:SymbolIcon ArrowUp24}" Style="{StaticResource IconButton}" ToolTip="Pasta acima (Alt+↑)" />
            <ui:Button AutomationProperties.Name="Atualizar" Command="{Binding LoadCommand}" Icon="{ui:SymbolIcon ArrowSync24}" Style="{StaticResource IconButton}" ToolTip="Atualizar (F5)" />
            <Border Width="1" Height="24" Margin="8,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <ui:Button Margin="0,0,4,0" Style="{StaticResource SubtleButton}" Command="{Binding NewFolderCommand}" Content="Nova pasta" Icon="{ui:SymbolIcon FolderAdd24}" ToolTip="Ctrl+Shift+N" />
            <ui:Button Margin="0,0,4,0" Style="{StaticResource SubtleButton}" Command="{Binding PasteCommand}" Content="Colar aqui" Icon="{ui:SymbolIcon DocumentCopy24}"
                       Visibility="{Binding HasClipboard, Converter={StaticResource BoolToVis}}" />
            <ui:Button Command="{Binding ToggleHiddenCommand}" Content="{Binding HiddenToggleLabel}" Style="{StaticResource SubtleButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="{Binding HiddenToggleIcon}" />
                </ui:Button.Icon>
            </ui:Button>
        </WrapPanel>

        <ui:InfoBar
            Grid.Row="2"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding IsProtected}"
            Message="Você pode ver os arquivos. Para criar, mover ou apagar, o app faz a operação por dentro do Linux como root e pede sua confirmação antes."
            Severity="Warning"
            Title="Esta pasta não é sua." />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Favoritos e locais  -->
            <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="10,0,0,6" Style="{StaticResource ColumnHeader}" Text="Favoritos" />
                    <TextBlock Margin="10,0,0,8" Style="{StaticResource Caption}" Text="Fixe pastas com a estrela."
                               Visibility="{Binding HasNoFavorites, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Place}">
                                <ui:Button
                                    Height="40"
                                    Padding="10,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource SubtleButton}"
                                    Command="{Binding DataContext.GoToPlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Path}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,10,0" Filled="True" Foreground="{DynamicResource SystemFillColorCautionBrush}" Symbol="Star24" />
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="10,16,0,6" Style="{StaticResource ColumnHeader}" Text="{Binding Distro}" />
                    <ItemsControl ItemsSource="{Binding Places}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Place}">
                                <ui:Button
                                    Height="40"
                                    Padding="10,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource SubtleButton}"
                                    Command="{Binding DataContext.GoToPlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Path}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,10,0" Symbol="Folder24" />
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!--  Conteúdo da pasta  -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <DockPanel Visibility="{Binding PermissionDenied, Converter={StaticResource InverseBoolToVis}}">
                        <Grid Height="40" Margin="16,0,8,0" DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="Nome" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="Modificado" />
                            <TextBlock Grid.Column="2" Margin="0,0,16,0" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="Tamanho" />
                            <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Dono" />
                        </Grid>
                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" DockPanel.Dock="Top" />

                        <!--  Rodapé: arrastar do Windows, paginação e status  -->
                        <DockPanel Margin="16,8" DockPanel.Dock="Bottom" LastChildFill="False">
                            <TextBlock VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <ui:Button Appearance="Secondary" Command="{Binding ShowMoreCommand}" Content="Mostrar mais itens" DockPanel.Dock="Right"
                                       Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                        <Border
                            Margin="12,8,12,0"
                            Padding="14,10"
                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            DockPanel.Dock="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="ArrowUpload24" />
                                <TextBlock Style="{StaticResource Caption}" Text="Arraste arquivos do Windows para cá para copiá-los para esta pasta. Arraste daqui para o Explorer para levar para o Windows." />
                            </StackPanel>
                        </Border>

                        <ListBox
                            x:Name="FileList"
                            AllowDrop="True"
                            AutomationProperties.Name="Conteúdo da pasta"
                            DragOver="OnDragOver"
                            Drop="OnDrop"
                            ItemsSource="{Binding Items}"
                            MouseDoubleClick="OnDoubleClick"
                            PreviewKeyDown="OnListKeyDown"
                            PreviewMouseLeftButtonDown="OnListMouseDown"
                            PreviewMouseMove="OnListMouseMove"
                            PreviewMouseRightButtonDown="OnListRightMouseDown"
                            SelectedItem="{Binding Selected}"
                            Style="{StaticResource PlainList}">
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" Header="Abrir" />
                                    <Separator />
                                    <MenuItem Command="{Binding OpenInVsCodeCommand}" CommandParameter="{Binding Selected}" Header="Abrir no VS Code" Icon="{ui:SymbolIcon Code24}" InputGestureText="Ctrl+Shift+V" />
                                    <MenuItem Command="{Binding OpenTerminalCommand}" CommandParameter="{Binding Selected}" Header="Abrir terminal aqui" Icon="{ui:SymbolIcon WindowConsole20}" InputGestureText="Ctrl+Shift+T" />
                                    <MenuItem Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding Selected}" Header="Abrir no Explorer" Icon="{ui:SymbolIcon FolderOpen24}" InputGestureText="Ctrl+Shift+E" />
                                    <Separator />
                                    <MenuItem Command="{Binding CopyLinuxPathCommand}" CommandParameter="{Binding Selected}" Header="Copiar caminho Linux" Icon="{ui:SymbolIcon Copy24}" InputGestureText="Ctrl+Shift+C" />
                                    <MenuItem Command="{Binding CopyWindowsPathCommand}" CommandParameter="{Binding Selected}" Header="Copiar caminho Windows" />
                                    <MenuItem Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding Selected}" Header="Fixar/remover dos favoritos" Icon="{ui:SymbolIcon Star24}" />
                                    <Separator />
                                    <MenuItem Command="{Binding CopyCommand}" CommandParameter="{Binding Selected}" Header="Copiar" InputGestureText="Ctrl+C" />
                                    <MenuItem Command="{Binding CutCommand}" CommandParameter="{Binding Selected}" Header="Recortar" InputGestureText="Ctrl+X" />
                                    <MenuItem Command="{Binding PasteCommand}" Header="Colar aqui" InputGestureText="Ctrl+V" />
                                    <MenuItem Command="{Binding RenameCommand}" CommandParameter="{Binding Selected}" Header="Renomear" Icon="{ui:SymbolIcon Rename24}" InputGestureText="F2" />
                                    <MenuItem Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Header="Excluir" Icon="{ui:SymbolIcon Delete24}" InputGestureText="Del" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <Grid MinHeight="44" Margin="16,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <ui:SymbolIcon x:Name="Ico" Margin="0,0,10,0" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="DocumentText24" />
                                            <TextBlock x:Name="NameText" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding Note}"
                                                       Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Modified}" />
                                        <TextBlock Grid.Column="2" Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Size}" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Owner}" />
                                            <ui:SymbolIcon Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="LockClosed24"
                                                           Visibility="{Binding IsRootOwned, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                            <Setter TargetName="Ico" Property="Symbol" Value="Folder24" />
                                            <Setter TargetName="Ico" Property="Filled" Value="True" />
                                            <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                            <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!--  Sem permissão para listar  -->
                    <StackPanel Margin="24,56" HorizontalAlignment="Center" Visibility="{Binding PermissionDenied, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="LockClosed24" />
                        <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Sem permissão para abrir esta pasta" />
                        <TextBlock MaxWidth="440" HorizontalAlignment="Center" Style="{StaticResource Secondary}" TextAlignment="Center"
                                   Text="Ela pertence a outro usuário. O app pode listá-la por dentro do Linux como root, depois da sua confirmação." />
                        <ui:Button Margin="0,16,0,0" HorizontalAlignment="Center" Appearance="Primary" Command="{Binding ViewAsRootCommand}" Content="Ver como root" Icon="{ui:SymbolIcon LockClosed24}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Distro desligada  -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Style="{StaticResource EmptyState}" Visibility="{Binding State.IsDistroOff, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Power24" />
                    <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="A distro está desligada" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="Ligue a distro para navegar pelos arquivos." />
                    <ui:Button Margin="0,16,0,0" HorizontalAlignment="Center" Appearance="Primary" Click="OnStartDistro" Content="Ligar a distro" Icon="{ui:SymbolIcon Play24}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
