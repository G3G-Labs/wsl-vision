<UserControl
    x:Class="WslVision.Views.Pages.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:layout="clr-namespace:WslVision.Views.Layout"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:FilesViewModel}"
    mc:Ignorable="d">

    <!--  Atalhos de teclado  -->
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding OpenInVsCodeCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+Shift+V" />
        <KeyBinding Command="{Binding OpenTerminalCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+Shift+T" />
        <KeyBinding Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+Shift+E" />
        <KeyBinding Command="{Binding CopyLinuxPathCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+Shift+C" />
        <KeyBinding Command="{Binding NewFolderCommand}" Gesture="Ctrl+Shift+N" />
        <KeyBinding Command="{Binding RenameCommand}" CommandParameter="{Binding Selected}" Key="F2" />
        <KeyBinding Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" Key="Delete" />
        <KeyBinding Command="{Binding LoadCommand}" Key="F5" />
        <KeyBinding Command="{Binding UpCommand}" Gesture="Alt+Up" />
        <KeyBinding Command="{Binding BackCommand}" Gesture="Alt+Left" />
        <KeyBinding Command="{Binding CopyCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+C" />
        <KeyBinding Command="{Binding CutCommand}" CommandParameter="{Binding Selected}" Gesture="Ctrl+X" />
        <KeyBinding Command="{Binding PasteCommand}" Gesture="Ctrl+V" />
    </UserControl.InputBindings>


    <UserControl.Resources>
        <!--  Local na coluna da esquerda; o da pasta aberta fica destacado  -->
        <DataTemplate x:Key="PlaceTemplate" DataType="{x:Type vm:Place}">
            <Button
                x:Name="Btn"
                Height="36"
                Padding="10,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Command="{Binding DataContext.GoToPlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Foreground="#C9CDD3"
                Style="{StaticResource BtnGhost}"
                ToolTip="{Binding Path}">
                <DockPanel>
                    <ui:SymbolIcon x:Name="Ico" Margin="0,0,10,0" DockPanel.Dock="Left" FontSize="15" Symbol="Folder24" />
                    <ui:SymbolIcon Margin="6,0,0,0" AutomationProperties.Name="Pertence ao root" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Wv.Text3}" Symbol="LockClosed24"
                                   Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="Ico" Property="Symbol" Value="Star24" />
                    <Setter TargetName="Ico" Property="Filled" Value="True" />
                    <Setter TargetName="Ico" Property="FontSize" Value="14" />
                    <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource Wv.Amber}" />
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource AllEqual}">
                            <Binding Path="Path" />
                            <Binding Path="DataContext.CurrentPath" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="Btn" Property="Background" Value="#1D2228" />
                    <Setter TargetName="Btn" Property="Foreground" Value="{StaticResource Wv.Text}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Locais: lista na coluna; empilhados, uma fileira de botões sem os títulos  -->
        <Style x:Key="HideWhenStacked" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="layout:SplitPanel.IsStacked" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlaceHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Style.Triggers>
                <Trigger Property="layout:SplitPanel.IsStacked" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlaceList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource PlaceTemplate}" />
            <Style.Triggers>
                <Trigger Property="layout:SplitPanel.IsStacked" Value="True">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Colunas pela largura da lista: Dono sai abaixo de 620, Modificado abaixo de 460  -->
        <Style x:Key="CellModified" TargetType="Border" BasedOn="{StaticResource HideCompact}">
            <Setter Property="Width" Value="140" />
        </Style>
        <Style x:Key="CellOwner" TargetType="Border" BasedOn="{StaticResource WideOnly}">
            <Setter Property="Width" Value="100" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,14" Style="{StaticResource PageTitle}" Text="Arquivos" />

        <!--  Barra de caminho: navegação, formato Linux/Windows e copiar no mesmo lugar; à direita, a ação principal (embaixo, no estreito)  -->
        <layout:SplitPanel Grid.Row="1" Margin="0,0,0,14" Spacing="8" StackBelow="820">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Width="36" Height="36" AutomationProperties.Name="Voltar" Command="{Binding BackCommand}" Style="{StaticResource BtnIcon}" ToolTip="Voltar (Alt+←)">
                        <ui:SymbolIcon FontSize="16" Symbol="ArrowLeft24" />
                    </Button>
                    <Button Width="36" Height="36" Margin="2,0,8,0" AutomationProperties.Name="Pasta acima" Command="{Binding UpCommand}" Style="{StaticResource BtnIcon}" ToolTip="Pasta acima (Alt+↑)">
                        <ui:SymbolIcon FontSize="16" Symbol="ArrowUp24" />
                    </Button>
                </StackPanel>
                <Border Height="36" Padding="6,0,4,0" Background="{StaticResource Wv.Surface}" BorderBrush="#26282D" BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <Button Width="32" Height="28" Margin="4,0,0,0" AutomationProperties.Name="Copiar caminho" Command="{Binding CopyCurrentPathCommand}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Copiar caminho (Ctrl+Shift+C)">
                            <ui:SymbolIcon FontSize="15" Symbol="Copy24" />
                        </Button>
                        <Button Width="32" Height="28" AutomationProperties.Name="Fixar nos favoritos" Command="{Binding ToggleFavoriteCommand}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Fixar nos favoritos e no menu da bandeja">
                            <ui:SymbolIcon FontSize="15" Filled="{Binding IsFavorite}" Symbol="Star24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Wv.Amber}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Button>
                        <Border Margin="6,0,2,0" Padding="2" VerticalAlignment="Center" Background="{StaticResource Wv.Layer}" CornerRadius="6" DockPanel.Dock="Right">
                            <StackPanel AutomationProperties.Name="Formato do caminho" Orientation="Horizontal">
                                <RadioButton Height="24" Padding="8,0" Content="Linux" FontSize="12" GroupName="PathFormat" IsChecked="{Binding IsLinuxPath}" Style="{StaticResource SegmentItem}" />
                                <RadioButton Height="24" Padding="8,0" Content="Windows" FontSize="12" GroupName="PathFormat" IsChecked="{Binding IsWindowsPath}" Style="{StaticResource SegmentItem}" />
                            </StackPanel>
                        </Border>
                        <Grid ClipToBounds="True">
                            <!--  Linux: trilha clicável  -->
                            <ItemsControl VerticalAlignment="Center" AutomationProperties.Name="Caminho" ItemsSource="{Binding Breadcrumbs}" Visibility="{Binding IsLinuxPath, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:Crumb}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Sep" Margin="1,0" VerticalAlignment="Center" FontSize="12" Foreground="#4A4E55" Text="/" />
                                            <Button
                                                Height="28"
                                                Padding="7,0"
                                                Command="{Binding DataContext.GoToCrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Name}"
                                                FontFamily="{StaticResource Wv.Mono}"
                                                FontSize="12.5"
                                                Foreground="{StaticResource Wv.Text2}"
                                                Style="{StaticResource BtnGhost}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!--  Windows: o caminho que o Explorer entende  -->
                            <TextBox
                                Margin="4,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Caminho no Windows"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="{StaticResource Wv.Mono}"
                                FontSize="12.5"
                                Foreground="{StaticResource Wv.Text}"
                                IsReadOnly="True"
                                Style="{x:Null}"
                                CaretBrush="{StaticResource Wv.Text}"
                                Text="{Binding WindowsPath, Mode=OneWay}"
                                Visibility="{Binding IsWindowsPath, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>
            <StackPanel Orientation="Horizontal">
                <Button Margin="0,0,8,0" Command="{Binding OpenInVsCodeCommand}" CommandParameter="{Binding Selected}" Style="{StaticResource BtnPrimary}" ToolTip="Ctrl+Shift+V">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Symbol="Code24" />
                        <TextBlock MaxWidth="240" VerticalAlignment="Center" Text="{Binding CodeLabel}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,0" Padding="12,0" Command="{Binding OpenTerminalCommand}" CommandParameter="{Binding Selected}" Content="Terminal" Style="{StaticResource BtnSecondary}" ToolTip="Terminal na pasta (Ctrl+Shift+T)" />
                <Button Padding="12,0" Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding Selected}" Content="Explorer" Style="{StaticResource BtnSecondary}" ToolTip="Abrir no Explorer (Ctrl+Shift+E)" />
            </StackPanel>
        </layout:SplitPanel>

        <Grid Grid.Row="2">
            <!--  Locais ao lado da pasta; no estreito, viram uma fileira em cima dela. Com a distro desligada, o aviso abaixo ocupa o lugar (a última listagem não vale mais)  -->
            <layout:SplitPanel FirstWidth="220" SecondWidth="*" Spacing="14" StackBelow="760" StackedSecondHeight="*"
                               Visibility="{Binding State.IsDistroOff, Converter={StaticResource InverseBoolToVis}}">
                <!--  Favoritos e locais  -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Margin="10,0,0,6" Style="{StaticResource PlaceHeader}" Text="FAVORITOS" />
                        <Border Style="{StaticResource HideWhenStacked}">
                            <TextBlock Margin="10,0,0,8" Style="{StaticResource Caption}" Text="Fixe pastas com a estrela."
                                       Visibility="{Binding HasNoFavorites, Converter={StaticResource BoolToVis}}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Favorites}" Style="{StaticResource PlaceList}" />
                        <TextBlock Margin="10,16,0,6" Style="{StaticResource PlaceHeader}" Text="{Binding Distro}" />
                        <ItemsControl ItemsSource="{Binding Places}" Style="{StaticResource PlaceList}" />
                    </StackPanel>
                </ScrollViewer>

                <!--  Conteúdo da pasta  -->
                <Border ClipToBounds="True" Style="{StaticResource CardBorder}" layout:Responsive.CompactBelow="460" layout:Responsive.MediumBelow="620" layout:Responsive.Track="True">
                    <Grid>
                        <DockPanel Visibility="{Binding PermissionDenied, Converter={StaticResource InverseBoolToVis}}">
                            <!--  Pasta do root: dá para ver; alterar passa por confirmação  -->
                            <Border Padding="14,10" Background="{StaticResource Wv.AmberSoft}" BorderBrush="#40F0B13B" BorderThickness="0,0,0,1" DockPanel.Dock="Top"
                                    Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,10,0" FontSize="15" Foreground="{StaticResource Wv.AmberText}" Symbol="LockClosed24" />
                                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Wv.AmberText}" TextWrapping="Wrap"
                                               Text="Pasta do root: você pode ver. Para alterar, o app faz por dentro do Linux como root e pede confirmação." />
                                </StackPanel>
                            </Border>

                            <!--  Contagem e operações da pasta  -->
                            <Border Padding="14,8,8,8" BorderBrush="{StaticResource Wv.Border}" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Height="30" Margin="0,0,2,0" Command="{Binding PasteCommand}" Foreground="#C9CDD3" Style="{StaticResource BtnGhost}" ToolTip="Ctrl+V"
                                                Visibility="{Binding HasClipboard, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="ClipboardPaste24" />
                                                <TextBlock VerticalAlignment="Center" Text="Colar aqui" />
                                            </StackPanel>
                                        </Button>
                                        <Button Height="30" Margin="0,0,2,0" Command="{Binding NewFolderCommand}" Foreground="#C9CDD3" Style="{StaticResource BtnGhost}" ToolTip="Ctrl+Shift+N">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Add24" />
                                                <TextBlock VerticalAlignment="Center" Text="Nova pasta" />
                                            </StackPanel>
                                        </Button>
                                        <Button Height="30" Margin="0,0,2,0" Command="{Binding ToggleHiddenCommand}" Content="{Binding HiddenToggleLabel}" Foreground="#C9CDD3" Style="{StaticResource BtnGhost}" />
                                        <Button Width="30" Height="30" AutomationProperties.Name="Atualizar" Command="{Binding LoadCommand}" Style="{StaticResource BtnIcon}" ToolTip="Atualizar (F5)">
                                            <ui:SymbolIcon FontSize="14" Symbol="ArrowSync24" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Wv.Text3}" Text="{Binding CountLabel}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>

                            <Grid Margin="14,8,8,6" DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="Nome" />
                                <Border Grid.Column="1" Style="{StaticResource CellModified}">
                                    <TextBlock Style="{StaticResource ColumnHeader}" Text="Modificado" />
                                </Border>
                                <TextBlock Grid.Column="2" Margin="0,0,16,0" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="Tamanho" />
                                <Border Grid.Column="3" Style="{StaticResource CellOwner}">
                                    <TextBlock Style="{StaticResource ColumnHeader}" Text="Dono" />
                                </Border>
                            </Grid>

                            <!--  Rodapé: dicas e paginação  -->
                            <Border Padding="14,8" BorderBrush="{StaticResource Wv.Border}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom">
                                <DockPanel LastChildFill="True">
                                    <Button Height="28" Margin="8,0,0,0" Command="{Binding ShowMoreCommand}" Content="Mostrar mais itens" DockPanel.Dock="Right" FontSize="12" Style="{StaticResource BtnSecondary}"
                                            Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Wv.Text3}" TextTrimming="CharacterEllipsis"
                                               Text="Duplo clique abre · arraste do Windows para copiar para cá · clique direito para mais ações" />
                                </DockPanel>
                            </Border>

                            <ListBox
                                x:Name="FileList"
                                AllowDrop="True"
                                AutomationProperties.Name="Conteúdo da pasta"
                                DragOver="OnDragOver"
                                Drop="OnDrop"
                                ItemsSource="{Binding Items}"
                                MouseDoubleClick="OnDoubleClick"
                                PreviewKeyDown="OnListKeyDown"
                                PreviewMouseLeftButtonDown="OnListMouseDown"
                                PreviewMouseMove="OnListMouseMove"
                                PreviewMouseRightButtonDown="OnListRightMouseDown"
                                SelectedItem="{Binding Selected}"
                                Style="{StaticResource PlainList}">
                                <ListBox.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" Header="Abrir" />
                                        <Separator />
                                        <MenuItem Command="{Binding OpenInVsCodeCommand}" CommandParameter="{Binding Selected}" Header="Abrir no VS Code" Icon="{ui:SymbolIcon Code24}" InputGestureText="Ctrl+Shift+V" />
                                        <MenuItem Command="{Binding OpenTerminalCommand}" CommandParameter="{Binding Selected}" Header="Abrir terminal aqui" Icon="{ui:SymbolIcon WindowConsole20}" InputGestureText="Ctrl+Shift+T" />
                                        <MenuItem Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding Selected}" Header="Abrir no Explorer" Icon="{ui:SymbolIcon FolderOpen24}" InputGestureText="Ctrl+Shift+E" />
                                        <Separator />
                                        <MenuItem Command="{Binding CopyLinuxPathCommand}" CommandParameter="{Binding Selected}" Header="Copiar caminho Linux" Icon="{ui:SymbolIcon Copy24}" InputGestureText="Ctrl+Shift+C" />
                                        <MenuItem Command="{Binding CopyWindowsPathCommand}" CommandParameter="{Binding Selected}" Header="Copiar caminho Windows" />
                                        <MenuItem Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding Selected}" Header="Fixar/remover dos favoritos" Icon="{ui:SymbolIcon Star24}" />
                                        <Separator />
                                        <MenuItem Command="{Binding CopyCommand}" CommandParameter="{Binding Selected}" Header="Copiar" InputGestureText="Ctrl+C" />
                                        <MenuItem Command="{Binding CutCommand}" CommandParameter="{Binding Selected}" Header="Recortar" InputGestureText="Ctrl+X" />
                                        <MenuItem Command="{Binding PasteCommand}" Header="Colar aqui" InputGestureText="Ctrl+V" />
                                        <MenuItem Command="{Binding RenameCommand}" CommandParameter="{Binding Selected}" Header="Renomear" Icon="{ui:SymbolIcon Rename24}" InputGestureText="F2" />
                                        <MenuItem Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Header="Excluir" Icon="{ui:SymbolIcon Delete24}" InputGestureText="Del" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                        <Grid MinHeight="44" Margin="16,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!--  DockPanel (e não StackPanel) para o nome longo encurtar com reticências em vez de invadir as outras colunas  -->
                                            <DockPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon x:Name="Ico" Margin="0,0,10,0" DockPanel.Dock="Left" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="DocumentText24" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Note}"
                                                           Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                                <TextBlock x:Name="NameText" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            </DockPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CellModified}">
                                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Modified}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Size}" />
                                            <Border Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource CellOwner}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Owner}" />
                                                    <ui:SymbolIcon Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="LockClosed24"
                                                                   Visibility="{Binding IsRootOwned, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter TargetName="Ico" Property="Symbol" Value="Folder24" />
                                                <Setter TargetName="Ico" Property="Filled" Value="True" />
                                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!--  Sem permissão para listar  -->
                        <StackPanel Margin="24,56" HorizontalAlignment="Center" Visibility="{Binding PermissionDenied, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon HorizontalAlignment="Center" FontSize="36" Foreground="{StaticResource Wv.Text3}" Symbol="LockClosed24" />
                            <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Sem permissão para abrir esta pasta" />
                            <TextBlock MaxWidth="440" HorizontalAlignment="Center" Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="Ela pertence a outro usuário. O app pode listá-la por dentro do Linux como root, depois da sua confirmação." />
                            <Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding ViewAsRootCommand}" Style="{StaticResource BtnPrimary}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Symbol="LockClosed24" />
                                    <TextBlock VerticalAlignment="Center" Text="Ver como root" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </layout:SplitPanel>

            <!--  Distro desligada  -->
            <Border VerticalAlignment="Top" Style="{StaticResource EmptyState}" Visibility="{Binding State.IsDistroOff, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="36" Foreground="{StaticResource Wv.Text3}" Symbol="Power24" />
                    <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="A distro está desligada" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="Ligue a distro para navegar pelos arquivos." />
                    <Button Margin="0,16,0,0" HorizontalAlignment="Center" Click="OnStartDistro" Style="{StaticResource BtnPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,7,0" FontSize="13" Filled="True" Symbol="Play24" />
                            <TextBlock VerticalAlignment="Center" Text="Ligar a distro" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
