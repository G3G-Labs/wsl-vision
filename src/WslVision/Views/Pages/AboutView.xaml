<UserControl
    x:Class="WslVision.Views.Pages.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:layout="clr-namespace:WslVision.Views.Layout"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
    mc:Ignorable="d">

    <!--  Sobre: o app à esquerda, a empresa que o criou à direita (um embaixo do outro no estreito)  -->
    <UserControl.Resources>
        <!--  Linha de informação: rótulo, valor e uma ação  -->
        <Style x:Key="InfoRow" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="96" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Wv.Text3}" />
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Wv.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="InfoDivider" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Wv.Divider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">
            <Button Height="30" Margin="-10,0,0,8" Padding="10,0" HorizontalAlignment="Left" AutomationProperties.Name="Voltar para Ajustes"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding DataContext.Settings, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{StaticResource Wv.Text2}" Style="{StaticResource BtnGhost}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="ArrowLeft24" />
                    <TextBlock VerticalAlignment="Center" Text="Ajustes" />
                </StackPanel>
            </Button>
            <TextBlock Margin="0,0,0,20" Style="{StaticResource PageTitle}" Text="Sobre" />

            <layout:SplitPanel FirstWidth="*" SecondWidth="*" Spacing="16" StackBelow="820">
                <!--  O app  -->
                <Border Padding="22,20" VerticalAlignment="Top" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" Style="{StaticResource SectionLabel}" Text="O APP" />
                        <DockPanel Margin="0,0,0,16">
                            <Image Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center" DockPanel.Dock="Left" RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="pack://application:,,,/Assets/logo.png" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="20">
                                    <Run FontWeight="Bold" Text="WSL" /><Run FontWeight="Medium" Text=" Vision" />
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource Wv.Text2}" Text="{Binding VersionLabel}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Margin="0,0,0,12" Style="{StaticResource Secondary}" Text="Painel leve para WSL e Docker Engine. Sem engine próprio e sem processos em segundo plano." />

                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource InfoRow}">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Código-fonte" />
                            <Button Width="32" Height="32" AutomationProperties.Name="Abrir o código-fonte no GitHub" Command="{Binding OpenCommand}"
                                    CommandParameter="{x:Static vm:Company.Repository}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Abrir no navegador">
                                <ui:SymbolIcon FontSize="14" Symbol="Open24" />
                            </Button>
                            <TextBlock FontFamily="{StaticResource Wv.Mono}" Style="{StaticResource InfoValue}" Text="github.com/G3G-Labs/wsl-vision" />
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource InfoRow}">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Licença" />
                            <Button Width="32" Height="32" AutomationProperties.Name="Ler a licença" Command="{Binding OpenCommand}"
                                    CommandParameter="{x:Static vm:Company.License}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Ler a licença">
                                <ui:SymbolIcon FontSize="14" Symbol="Open24" />
                            </Button>
                            <TextBlock Style="{StaticResource InfoValue}" Text="MIT: livre para usar, alterar e distribuir" />
                        </DockPanel>
                        <Border Margin="0,0,0,16" Style="{StaticResource InfoDivider}" />

                        <Button HorizontalAlignment="Left" Command="{Binding OpenSettingsFolderCommand}" Style="{StaticResource BtnSecondary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Symbol="FolderOpen24" />
                                <TextBlock VerticalAlignment="Center" Text="Abrir pasta de configurações" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!--  A empresa  -->
                <Border Padding="22,20" VerticalAlignment="Top" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14" Style="{StaticResource SectionLabel}" Text="FEITO POR" />
                        <DockPanel Margin="0,0,0,16">
                            <Image Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="Logo da G3G Labs" DockPanel.Dock="Left"
                                   Source="{StaticResource G3GMark}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Static vm:Company.Name}" />
                                <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource Wv.Text2}" Text="{x:Static vm:Company.Tagline}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Margin="0,0,0,12" Style="{StaticResource Secondary}" Text="{x:Static vm:Company.Region}" />

                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource InfoRow}">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Site" />
                            <Button Width="32" Height="32" AutomationProperties.Name="Abrir o site da G3G Labs" Command="{Binding OpenCommand}"
                                    CommandParameter="{x:Static vm:Company.Site}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Abrir no navegador">
                                <ui:SymbolIcon FontSize="14" Symbol="Open24" />
                            </Button>
                            <TextBlock Style="{StaticResource InfoValue}" Text="{x:Static vm:Company.SiteLabel}" />
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource InfoRow}">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="CNPJ" />
                            <Button Width="32" Height="32" AutomationProperties.Name="Copiar o CNPJ" Command="{Binding CopyCnpjCommand}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Copiar">
                                <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                            </Button>
                            <TextBlock FontFamily="{StaticResource Wv.Mono}" Style="{StaticResource InfoValue}" Text="{x:Static vm:Company.Cnpj}" />
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource InfoRow}">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="E-mail" />
                            <Button Width="32" Height="32" AutomationProperties.Name="Escrever para a G3G Labs" Command="{Binding WriteEmailCommand}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Escrever um e-mail">
                                <ui:SymbolIcon FontSize="14" Symbol="Mail24" />
                            </Button>
                            <TextBlock Style="{StaticResource InfoValue}" Text="{x:Static vm:Company.Email}" />
                        </DockPanel>
                        <Border Style="{StaticResource InfoDivider}" />
                        <DockPanel Style="{StaticResource InfoRow}">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="Redes" />
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Button Height="30" Margin="-10,0,4,0" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:Company.Instagram}" Content="Instagram"
                                        AutomationProperties.Name="Abrir o Instagram da G3G Labs" Foreground="{StaticResource Wv.AccentText}" Style="{StaticResource BtnGhost}" ToolTip="@g3glabs" />
                                <Button Height="30" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:Company.LinkedIn}" Content="LinkedIn"
                                        AutomationProperties.Name="Abrir o LinkedIn da G3G Labs" Foreground="{StaticResource Wv.AccentText}" Style="{StaticResource BtnGhost}" ToolTip="G3G Labs no LinkedIn" />
                            </StackPanel>
                        </DockPanel>
                        <Border Margin="0,0,0,16" Style="{StaticResource InfoDivider}" />

                        <Button HorizontalAlignment="Left" Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:Company.Site}" Style="{StaticResource BtnPrimary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Symbol="Globe24" />
                                <TextBlock VerticalAlignment="Center" Text="Visitar o site" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </layout:SplitPanel>

            <TextBlock Margin="0,20,0,0" Style="{StaticResource Caption}" Text="{Binding Copyright}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
