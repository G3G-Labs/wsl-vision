<UserControl
    x:Class="WslVision.Views.Pages.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:layout="clr-namespace:WslVision.Views.Layout"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:TerminalViewModel}"
    mc:Ignorable="d">

    <!--
        Terminal com workspaces: barra lateral de grupos e abas, cabeçalho da aba, terminal e barra de status.
        Os atalhos valem com o foco na barra lateral; com o foco dentro do terminal (uma janela nativa), o código da view os trata.
    -->
    <UserControl.InputBindings>
        <KeyBinding Command="{Binding AddTabCommand}" Gesture="Ctrl+Shift+T" />
        <KeyBinding Command="{Binding CloseTabCommand}" Gesture="Ctrl+Shift+W" />
        <KeyBinding Command="{Binding StartTabCommand}" Gesture="Ctrl+Shift+R" />
        <KeyBinding Command="{Binding StartGroupCommand}" Gesture="Ctrl+Shift+Enter" />
        <KeyBinding Command="{Binding AddGroupCommand}" Gesture="Ctrl+Shift+N" />
        <KeyBinding Command="{Binding OpenInVsCodeCommand}" Gesture="Ctrl+Shift+E" />
        <KeyBinding Command="{Binding NextTabCommand}" Gesture="Ctrl+Tab" />
        <KeyBinding Command="{Binding PreviousTabCommand}" Gesture="Ctrl+Shift+Tab" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!--  Some na barra lateral recolhida (só os pontos de estado)  -->
        <Style x:Key="HideWhenMini" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Sidebar" TargetType="Border">
            <Setter Property="Width" Value="256" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                    <Setter Property="Width" Value="60" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{StaticResource Wv.Layer}" />
            <Setter Property="BorderBrush" Value="#26282D" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Wv.Text2}" />
        </Style>

        <!--  Nome da aba no cabeçalho: parece texto, vira campo ao passar o mouse ou focar  -->
        <Style x:Key="TabNameBox" TargetType="TextBox">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Wv.Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Wv.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Wv.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Wv.Accent}" />
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Wv.Layer}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Uma aba na barra lateral: ponto de estado, nome e, embaixo, a branch (ou o código do erro)  -->
        <DataTemplate x:Key="TabRow" DataType="{x:Type vm:WorkspaceTabViewModel}">
            <Border
                x:Name="Row"
                MinHeight="40"
                Margin="0,1"
                Padding="30,4,10,4"
                AutomationProperties.HelpText="Enter seleciona. Clique duplo inicia uma aba parada. Shift+F10 mostra as ações."
                AutomationProperties.Name="{Binding AccessibleName}"
                Background="Transparent"
                CornerRadius="7"
                Cursor="Hand"
                Focusable="True"
                FocusVisualStyle="{StaticResource RoundFocusVisual}"
                KeyboardNavigation.IsTabStop="True"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                ToolTip="{Binding ResolvedFolder}">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="LeftClick" />
                    <MouseBinding Command="{Binding DataContext.OpenTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="LeftDoubleClick" />
                    <MouseBinding Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="MiddleClick" />
                    <KeyBinding Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Key="Enter" />
                    <KeyBinding Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Key="Space" />
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding PlacementTarget.Tag.StartTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="{Binding StartLabel}" Icon="{ui:SymbolIcon Play24}" InputGestureText="Ctrl+Shift+R" />
                        <MenuItem Command="{Binding PlacementTarget.Tag.StopTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Parar (Ctrl+C)" Icon="{ui:SymbolIcon Stop24}" IsEnabled="{Binding CanStop}" />
                        <MenuItem Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Fechar o terminal" Icon="{ui:SymbolIcon Dismiss24}" InputGestureText="Ctrl+Shift+W" IsEnabled="{Binding IsStarted}" />
                        <Separator />
                        <MenuItem Command="{Binding PlacementTarget.Tag.DuplicateTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Duplicar" Icon="{ui:SymbolIcon Copy24}" />
                        <MenuItem Command="{Binding PlacementTarget.Tag.MoveTabUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Mover para cima" Icon="{ui:SymbolIcon ArrowUp24}" />
                        <MenuItem Command="{Binding PlacementTarget.Tag.MoveTabDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Mover para baixo" Icon="{ui:SymbolIcon ArrowDown24}" />
                        <Separator />
                        <MenuItem Command="{Binding PlacementTarget.Tag.RemoveTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Foreground="{StaticResource Wv.Red}" Header="Remover…" Icon="{ui:SymbolIcon Delete24}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel x:Name="RowContent">
                    <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left" Fill="Transparent" Stroke="{StaticResource Wv.Gray}" StrokeThickness="1.5" />
                    <StackPanel Margin="6,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal" Style="{StaticResource HideWhenMini}">
                        <!--  Projeto Compose da aba (o escolhido ou o da pasta): a cor diz se os containers estão no ar  -->
                        <ui:SymbolIcon Margin="0,0,4,0" FontSize="12" Foreground="{Binding ComposeTone, Converter={StaticResource ToneBrush}}" Symbol="Box24" ToolTip="{Binding ComposeTip}"
                                       Visibility="{Binding HasCompose, Converter={StaticResource BoolToVis}}" />
                        <ui:SymbolIcon FontSize="12" Foreground="{StaticResource Wv.Amber}" Symbol="LockClosed24" ToolTip="Abre como root" Visibility="{Binding Root, Converter={StaticResource BoolToVis}}" />
                        <Border Margin="4,0,0,0" Padding="4,0" BorderBrush="{StaticResource Wv.BorderStrong}" BorderThickness="1" CornerRadius="4" ToolTip="Inicia automaticamente"
                                Visibility="{Binding Autostart, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="10" Foreground="{StaticResource Wv.Text3}" Text="auto" />
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Style="{StaticResource HideWhenMini}">
                        <TextBlock x:Name="NameText" FontSize="13" Foreground="#C9CDD3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubText" FontFamily="{StaticResource Wv.Mono}" FontSize="11" Foreground="{StaticResource Wv.Text3}" Text="{Binding SubText}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSub, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Wv.Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Wv.Selected}" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Wv.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Shell">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Wv.Accent}" />
                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Wv.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Wv.Green}" />
                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Wv.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Wv.Red}" />
                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Wv.Red}" />
                    <Setter TargetName="SubText" Property="Foreground" Value="{StaticResource Wv.Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="Row" Property="Padding" Value="0" />
                    <Setter TargetName="Row" Property="ToolTip" Value="{Binding AccessibleName}" />
                    <Setter TargetName="Dot" Property="Margin" Value="0" />
                    <Setter TargetName="RowContent" Property="HorizontalAlignment" Value="Center" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Barra lateral: workspaces e abas  -->
        <Border Grid.Column="0" BorderBrush="{StaticResource Wv.Divider}" BorderThickness="0,0,1,0" Style="{StaticResource Sidebar}">
            <DockPanel>
                <DockPanel Height="52" Margin="12,0,8,0" DockPanel.Dock="Top">
                    <Button Width="30" Height="30" AutomationProperties.Name="Recolher ou expandir a barra de workspaces" Command="{Binding ToggleSidebarCommand}" DockPanel.Dock="Left"
                            Style="{StaticResource BtnIcon}" ToolTip="Recolher ou expandir a barra">
                        <ui:SymbolIcon FontSize="16" Symbol="PanelLeft24" />
                    </Button>
                    <Button Width="30" Height="30" AutomationProperties.Name="Novo workspace" Command="{Binding AddGroupCommand}" DockPanel.Dock="Right"
                            Style="{StaticResource BtnIcon}" ToolTip="Novo workspace (Ctrl+Shift+N)">
                        <Button.Visibility>
                            <Binding Converter="{StaticResource InverseBoolToVis}" Path="SidebarCollapsed" />
                        </Button.Visibility>
                        <ui:SymbolIcon FontSize="15" Symbol="Add24" />
                    </Button>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Style="{StaticResource HideWhenMini}" Text="Workspaces" />
                </DockPanel>

                <!--  Rodapé: criar workspaces  -->
                <Border Padding="8" BorderBrush="{StaticResource Wv.Divider}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom" Style="{StaticResource HideWhenMini}">
                    <StackPanel>
                        <Button Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding AddGroupCommand}" Foreground="#C9CDD3" Style="{StaticResource BtnGhost}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="14" Symbol="Add24" />
                                <TextBlock VerticalAlignment="Center" Text="Novo workspace" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="FromComposeButton" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnFromComposeClick"
                                IsEnabled="{Binding HasComposeSuggestions}" Style="{StaticResource BtnGhost}" ToolTip="Um workspace com uma aba na pasta de um projeto do Docker Compose">
                            <!--  Os itens (projetos sem workspace) são montados ao clicar  -->
                            <Button.ContextMenu>
                                <ContextMenu />
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="14" Symbol="Box24" />
                                <TextBlock VerticalAlignment="Center" Text="A partir de um projeto Compose" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer Padding="8,0,8,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  Abas avulsas: não são salvas  -->
                        <StackPanel Margin="0,0,0,10" Visibility="{Binding HasLoose, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource HideWhenMini}">
                                <TextBlock Margin="8,0,0,4" Style="{StaticResource SectionLabel}" Text="ABERTAS AGORA" ToolTip="Abas avulsas não são salvas. Guarde num workspace pela configuração da aba." />
                            </Border>
                            <ItemsControl ItemTemplate="{StaticResource TabRow}" ItemsSource="{Binding Loose}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Groups}" KeyboardNavigation.TabNavigation="Continue">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WorkspaceGroupViewModel}">
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid x:Name="Header" MinHeight="34" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Command="{Binding PlacementTarget.Tag.StartGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Iniciar grupo" Icon="{ui:SymbolIcon Play24}" InputGestureText="Ctrl+Shift+Enter" />
                                                    <MenuItem Command="{Binding PlacementTarget.Tag.StopGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Parar grupo" Icon="{ui:SymbolIcon Stop24}" />
                                                    <MenuItem Command="{Binding PlacementTarget.Tag.AddTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Nova aba" Icon="{ui:SymbolIcon Add24}" InputGestureText="Ctrl+Shift+T" />
                                                    <Separator />
                                                    <MenuItem Command="{Binding PlacementTarget.Tag.EditGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Configurar…" Icon="{ui:SymbolIcon Settings24}" />
                                                    <MenuItem Command="{Binding PlacementTarget.Tag.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Renomear…" Icon="{ui:SymbolIcon Rename24}" />
                                                    <MenuItem Command="{Binding PlacementTarget.Tag.MoveGroupUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Mover para cima" Icon="{ui:SymbolIcon ArrowUp24}" />
                                                    <MenuItem Command="{Binding PlacementTarget.Tag.MoveGroupDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Mover para baixo" Icon="{ui:SymbolIcon ArrowDown24}" />
                                                    <Separator />
                                                    <MenuItem Command="{Binding PlacementTarget.Tag.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Foreground="{StaticResource Wv.Red}" Header="Remover workspace…" Icon="{ui:SymbolIcon Delete24}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <DockPanel>
                                                <!--  Ações aparecem com o mouse por cima ou o foco dentro  -->
                                                <StackPanel x:Name="Actions" VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Hidden">
                                                    <Button Width="26" Height="26" AutomationProperties.Name="{Binding Name, StringFormat=Iniciar o grupo {0}}" Foreground="{StaticResource Wv.Green}" Style="{StaticResource BtnIcon}" ToolTip="Iniciar grupo (Ctrl+Shift+Enter)"
                                                            Command="{Binding DataContext.StartGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon FontSize="11" Filled="True" Symbol="Play24" />
                                                    </Button>
                                                    <Button Width="26" Height="26" AutomationProperties.Name="{Binding Name, StringFormat=Parar o grupo {0}}" Style="{StaticResource BtnIcon}" ToolTip="Parar grupo (Ctrl+C em todas as abas)"
                                                            Command="{Binding DataContext.StopGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon FontSize="10" Filled="True" Symbol="Stop24" />
                                                    </Button>
                                                    <Button Width="26" Height="26" AutomationProperties.Name="{Binding Name, StringFormat=Nova aba em {0}}" Style="{StaticResource BtnIcon}" ToolTip="Nova aba (Ctrl+Shift+T)"
                                                            Command="{Binding DataContext.AddTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon FontSize="13" Symbol="Add24" />
                                                    </Button>
                                                    <Button Width="26" Height="26" AutomationProperties.Name="{Binding Name, StringFormat=Configurar o grupo {0}}" Style="{StaticResource BtnIcon}" ToolTip="Nome, cor, pasta e projeto Compose"
                                                            Command="{Binding DataContext.EditGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon FontSize="13" Symbol="Settings24" />
                                                    </Button>
                                                </StackPanel>
                                                <Button x:Name="Toggle" Height="34" Padding="6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name, StringFormat=Workspace {0}}"
                                                        Command="{Binding ToggleExpandedCommand}" Style="{StaticResource BtnGhost}" ToolTip="{Binding CountTip}">
                                                    <DockPanel>
                                                        <ui:SymbolIcon x:Name="Chevron" Margin="0,0,8,0" DockPanel.Dock="Left" FontSize="11" Foreground="{StaticResource Wv.Text3}" Symbol="ChevronDown24" Style="{StaticResource HideWhenMini}" />
                                                        <Border x:Name="Swatch" Width="11" Height="11" Margin="0,0,8,0" VerticalAlignment="Center" Background="{Binding Brush}" CornerRadius="3" DockPanel.Dock="Left" />
                                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Wv.Text3}" Style="{StaticResource HideWhenMini}" Text="{Binding CountText}" />
                                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Wv.Text}" Style="{StaticResource HideWhenMini}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Button>
                                            </DockPanel>
                                        </Grid>
                                        <ItemsControl x:Name="TabList" ItemTemplate="{StaticResource TabRow}" ItemsSource="{Binding Tabs}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Header" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="Header" Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <Setter TargetName="TabList" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Chevron" Property="Symbol" Value="ChevronRight24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Toggle" Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter TargetName="Swatch" Property="Margin" Value="0" />
                                            <Setter TargetName="Toggle" Property="ToolTip" Value="{Binding Name}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  Sem nenhum workspace ainda  -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="540" Margin="24,48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon HorizontalAlignment="Center" FontSize="40" Foreground="{StaticResource Wv.TextFaint}" Symbol="WindowConsole20" />
                <TextBlock Margin="0,14,0,6" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Seus terminais, do jeito que você deixou" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Junte as abas de cada projeto num workspace: nome, pasta e comando ficam salvos, e um clique sobe tudo de novo, até depois de reiniciar o PC." />
                <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Command="{Binding AddGroupCommand}" Style="{StaticResource BtnPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Symbol="Add24" />
                            <TextBlock VerticalAlignment="Center" Text="Criar workspace" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenLooseCommand}" Content="Só abrir um terminal" Style="{StaticResource BtnSecondary}" />
                </StackPanel>
                <ItemsControl Margin="0,24,0,0" ItemsSource="{Binding ComposeSuggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ContainerGroupViewModel}">
                            <Border Margin="0,0,0,8" Padding="14,10" Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <Button Command="{Binding DataContext.AddGroupFromComposeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Content="Criar workspace deste projeto" DockPanel.Dock="Right" Foreground="{StaticResource Wv.AccentText}" Style="{StaticResource BtnGhost}" />
                                    <ui:SymbolIcon Margin="0,0,12,0" DockPanel.Dock="Left" FontSize="18" Foreground="{StaticResource Wv.AccentText}" Symbol="Box24" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontFamily="{StaticResource Wv.Mono}" FontSize="12" Foreground="{StaticResource Wv.Text3}" Text="{Binding WorkingDirLabel}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!--  A aba selecionada  -->
        <DockPanel Grid.Column="1" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
            <!--  Cabeçalho: nome editável, pasta e ações  -->
            <Border MinHeight="52" Padding="16,8,12,8" BorderBrush="{StaticResource Wv.Divider}" BorderThickness="0,0,0,1" DockPanel.Dock="Top"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Height="30" Margin="0,0,4,0" Padding="10,0" Command="{Binding StartTabCommand}" Style="{StaticResource BtnSecondary}" ToolTip="Iniciar ou reiniciar a aba (Ctrl+Shift+R)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="13" Foreground="{StaticResource Wv.Green}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ArrowClockwise24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected.IsIdle}" Value="True">
                                                    <Setter Property="Symbol" Value="Play24" />
                                                    <Setter Property="Filled" Value="True" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Selected.StartLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Width="32" Height="32" AutomationProperties.Name="Parar o comando (Ctrl+C)" Command="{Binding StopTabCommand}" IsEnabled="{Binding Selected.CanStop}" Style="{StaticResource BtnIcon}" ToolTip="Parar o comando (envia Ctrl+C)">
                            <ui:SymbolIcon FontSize="12" Filled="True" Symbol="Stop24" />
                        </Button>
                        <Border Width="1" Height="18" Margin="4,0" Background="{StaticResource Wv.BorderStrong}" />
                        <Button Width="32" Height="32" AutomationProperties.Name="Abrir no VS Code" Command="{Binding OpenInVsCodeCommand}" Style="{StaticResource BtnIcon}" ToolTip="Abrir a pasta no VS Code (Ctrl+Shift+E)">
                            <ui:SymbolIcon FontSize="15" Symbol="Code24" />
                        </Button>
                        <Button Width="32" Height="32" AutomationProperties.Name="Abrir no Explorer" Command="{Binding OpenInExplorerCommand}" Style="{StaticResource BtnIcon}" ToolTip="Abrir a pasta no Explorer">
                            <ui:SymbolIcon FontSize="15" Symbol="FolderOpen24" />
                        </Button>
                        <Button Width="32" Height="32" AutomationProperties.Name="Configurar aba" Command="{Binding ToggleConfigCommand}" ToolTip="Pasta, comando, usuário e início automático">
                            <Button.Style>
                                <Style BasedOn="{StaticResource BtnIcon}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowConfig}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Wv.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon FontSize="15" Symbol="Options24" />
                        </Button>
                        <Button x:Name="MoreButton" Width="32" Height="32" AutomationProperties.Name="Mais ações" Click="OnMoreClick" Style="{StaticResource BtnIcon}" ToolTip="Mais ações">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding DuplicateTabCommand}" Header="Duplicar" Icon="{ui:SymbolIcon Copy24}" />
                                    <MenuItem Command="{Binding CopyPathCommand}" Header="Copiar caminho" Icon="{ui:SymbolIcon DocumentCopy24}" />
                                    <MenuItem Command="{Binding OpenExternalCommand}" Header="Abrir no Windows Terminal" Icon="{ui:SymbolIcon Open24}" />
                                    <MenuItem Command="{Binding CloseTabCommand}" Header="Fechar o terminal" Icon="{ui:SymbolIcon Dismiss24}" InputGestureText="Ctrl+Shift+W" />
                                    <Separator />
                                    <MenuItem Command="{Binding RemoveTabCommand}" Foreground="{StaticResource Wv.Red}" Header="Remover…" Icon="{ui:SymbolIcon Delete24}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <ui:SymbolIcon FontSize="15" Symbol="MoreHorizontal24" />
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Width="11" Height="11" Margin="0,0,8,0" VerticalAlignment="Center" Background="{Binding Selected.GroupBrush}" CornerRadius="3" />
                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Wv.Text3}" Text="{Binding Selected.GroupName}" />
                        <TextBlock Margin="6,0,2,0" VerticalAlignment="Center" Foreground="{StaticResource Wv.TextFaint}" Text="/" />
                        <TextBox x:Name="NameBox" AutomationProperties.Name="Nome da aba" KeyDown="OnNameKeyDown" Style="{StaticResource TabNameBox}" Text="{Binding Selected.Name, UpdateSourceTrigger=LostFocus}" />
                        <Border Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource WideOnly}">
                            <TextBlock MaxWidth="360" FontFamily="{StaticResource Wv.Mono}" FontSize="12" Foreground="{StaticResource Wv.Text3}" Text="{Binding Selected.ResolvedFolder}" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  Configurar o workspace: nome, cor, pasta base, Compose e início com o ambiente  -->
            <Border Padding="16,14,16,16" Background="{StaticResource Wv.Surface}" BorderBrush="{StaticResource Wv.Border}" BorderThickness="0,0,0,1" DockPanel.Dock="Top"
                    Visibility="{Binding IsEditingGroup, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button Width="30" Height="30" AutomationProperties.Name="Fechar configuração do workspace" Command="{Binding CloseGroupEditorCommand}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}">
                            <ui:SymbolIcon FontSize="12" Symbol="Dismiss24" />
                        </Button>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}">
                            <Run Text="Workspace " /><Run Text="{Binding EditingGroup.Name, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                    <layout:AdaptiveGrid ColumnSpacing="16" MaxColumns="2" MinColumnWidth="280" RowSpacing="12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nome" />
                            <TextBox AutomationProperties.Name="Nome do workspace" Style="{StaticResource Field}" Text="{Binding EditingGroup.Name, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta do workspace (onde as abas novas começam)" />
                            <DockPanel>
                                <Button Width="34" Height="34" Margin="6,0,0,0" Padding="0" AutomationProperties.Name="Escolher a pasta do workspace" Command="{Binding BrowseGroupFolderCommand}" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" ToolTip="Escolher pasta…">
                                    <ui:SymbolIcon FontSize="15" Symbol="FolderOpen24" />
                                </Button>
                                <TextBox AutomationProperties.Name="Pasta do workspace" FontFamily="{StaticResource Wv.Mono}" Style="{StaticResource Field}" Text="{Binding EditingGroup.Folder, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Projetos" />
                            <Button HorizontalAlignment="Left" Click="OnAddComposeTabClick" IsEnabled="{Binding HasComposeProjects}" Style="{StaticResource BtnSecondary}"
                                    ToolTip="Uma aba na pasta de um projeto do Docker Compose">
                                <Button.ContextMenu>
                                    <ContextMenu />
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Symbol="Box24" />
                                    <TextBlock VerticalAlignment="Center" Text="Adicionar projeto Compose…" />
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                                       Text="Cada aba é um projeto, na pasta dele: front-end e back-end ficam no mesmo workspace, cada um com o seu Compose. Iniciar grupo sobe os containers de todos antes das abas." />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Cor" />
                            <ItemsControl ItemsSource="{Binding EditingGroup.ColorChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="30" Height="30" Margin="0,0,6,6" Padding="0" AutomationProperties.Name="{Binding StringFormat=Cor {0}}"
                                                Command="{Binding DataContext.EditingGroup.SetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnIcon}">
                                            <Border Width="18" Height="18" Background="{Binding}" CornerRadius="5" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </layout:AdaptiveGrid>
                    <DockPanel Margin="0,12,0,0">
                        <Button Command="{Binding RemoveGroupCommand}" CommandParameter="{Binding EditingGroup}" Content="Remover workspace…" DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" />
                        <CheckBox VerticalAlignment="Center" Content="Subir junto com o Iniciar ambiente" IsChecked="{Binding EditingGroup.StartWithEnvironment}"
                                  ToolTip="Depois da distro, do Docker e dos projetos marcados, este workspace também inicia" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!--  Configurar a aba: no lugar, sem janela; vale ao sair do campo  -->
            <Border Padding="16,14,16,16" Background="{StaticResource Wv.Surface}" BorderBrush="{StaticResource Wv.Border}" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowConfig}" Value="True" />
                                    <Condition Binding="{Binding HasSelection}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <layout:AdaptiveGrid ColumnSpacing="16" MaxColumns="2" MinColumnWidth="280" RowSpacing="12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta inicial" />
                            <DockPanel>
                                <Button Width="34" Height="34" Margin="6,0,0,0" Padding="0" AutomationProperties.Name="Escolher a pasta da aba" Command="{Binding BrowseFolderCommand}" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" ToolTip="Escolher pasta…">
                                    <ui:SymbolIcon FontSize="15" Symbol="FolderOpen24" />
                                </Button>
                                <TextBox AutomationProperties.Name="Pasta inicial da aba" FontFamily="{StaticResource Wv.Mono}" Style="{StaticResource Field}" Text="{Binding Selected.Folder, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="&quot;.&quot; ou &quot;./api&quot; partem da pasta do workspace." Visibility="{Binding Selected.IsLoose, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Comando de inicialização" />
                            <ui:TextBox AutomationProperties.Name="Comando de inicialização" FontFamily="{StaticResource Wv.Mono}" PlaceholderText="npm run dev (opcional)" Text="{Binding Selected.Startup, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Projeto Compose" />
                            <ComboBox AutomationProperties.Name="Projeto Compose da aba" ItemsSource="{Binding ComposeProjects}" SelectedItem="{Binding Selected.ComposeProject}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Label" Text="{Binding}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="">
                                                <Setter TargetName="Label" Property="Text" Value="Automático (pela pasta da aba)" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding Selected.ComposeTip}" Visibility="{Binding Selected.HasCompose, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="Nenhum projeto Compose nesta pasta." Visibility="{Binding Selected.HasCompose, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Abrir como" />
                            <Border HorizontalAlignment="Left" Padding="3" Background="{StaticResource Wv.Layer}" BorderBrush="#26282D" BorderThickness="1" CornerRadius="8">
                                <StackPanel AutomationProperties.Name="Abrir como" Orientation="Horizontal">
                                    <RadioButton Content="Seu usuário" GroupName="TabUser" IsChecked="{Binding Selected.Root, Converter={StaticResource InverseBool}}" Style="{StaticResource SegmentItem}" />
                                    <RadioButton Content="root" GroupName="TabUser" IsChecked="{Binding Selected.Root}" Style="{StaticResource SegmentItem}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Wv.AmberText}" Style="{StaticResource Caption}" Text="Como root, a aba pode alterar qualquer arquivo da distro. O app pede confirmação toda vez que ela inicia."
                                       Visibility="{Binding Selected.Root, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel>
                            <!--  Aba de workspace: início automático. Aba avulsa: guardar num workspace  -->
                            <CheckBox Margin="0,22,0,0" Content="Iniciar automaticamente (assim que a distro estiver ligada)" IsChecked="{Binding Selected.Autostart}"
                                      Visibility="{Binding Selected.IsLoose, Converter={StaticResource InverseBoolToVis}}" />
                            <StackPanel Visibility="{Binding Selected.IsLoose, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Guardar num workspace (aba avulsa não é salva)" />
                                <DockPanel>
                                    <Button Margin="6,0,0,0" Command="{Binding SaveLooseCommand}" Content="Guardar" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" />
                                    <ComboBox AutomationProperties.Name="Workspace de destino" DisplayMemberPath="Name" ItemsSource="{Binding Groups}" SelectedItem="{Binding SaveTarget}" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </layout:AdaptiveGrid>
                </StackPanel>
            </Border>

            <!--  Barra de status  -->
            <Border Height="26" Padding="16,0,12,0" Background="{StaticResource Wv.Layer}" BorderBrush="{StaticResource Wv.Divider}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom"
                    TextElement.FontSize="12" TextElement.Foreground="{StaticResource Wv.Text3}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource WideOnly}">
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Wv.TextFaint}" Text="Ctrl+Shift+T nova aba · Ctrl+Shift+R iniciar" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,14,0" Text="{Binding Distro}" />
                        <TextBlock Margin="0,0,14,0" Text="{Binding StatusUser}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.Root}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Wv.Amber}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock MaxWidth="320" Margin="0,0,14,0" FontFamily="{StaticResource Wv.Mono}" FontSize="11.5" Text="{Binding StatusFolder}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Margin="0,0,14,0" Orientation="Horizontal" Visibility="{Binding Selected.HasBranch, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Margin="0,0,5,0" FontSize="12" Foreground="#C9CDD3" Symbol="Branch24" />
                            <TextBlock FontFamily="{StaticResource Wv.Mono}" FontSize="11.5" Foreground="#C9CDD3" Text="{Binding Selected.Branch}" />
                            <TextBlock Margin="6,0,0,0" Foreground="{StaticResource Wv.AmberText}" Text="{Binding Selected.GitText}" />
                        </StackPanel>
                        <Border Style="{StaticResource HideCompact}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasStatusCompose, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Margin="0,0,5,0" FontSize="12" Symbol="Box24" />
                                <TextBlock Text="{Binding StatusCompose}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  O terminal: ocupa todo o resto  -->
            <Grid Background="{StaticResource Wv.Surface}">
                <!--  Os terminais (um por aba iniciada) entram aqui pelo código; só o da aba selecionada fica visível  -->
                <Grid x:Name="TermHost" Margin="10,8" />

                <!--  Aba parada  -->
                <StackPanel MaxWidth="440" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected.IsIdle}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Ellipse Width="11" Height="11" HorizontalAlignment="Center" Stroke="{StaticResource Wv.Gray}" StrokeThickness="1.5" />
                    <TextBlock Margin="0,10,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Aba não iniciada" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Selected.IdleText}" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding StartTabCommand}" Visibility="{Binding Selected.Root, Converter={StaticResource InverseBoolToVis}}" Style="{StaticResource BtnPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,7,0" FontSize="12" Filled="True" Symbol="Play24" />
                            <TextBlock VerticalAlignment="Center" Text="Iniciar" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding StartTabCommand}" Foreground="{StaticResource Wv.AmberText}" Style="{StaticResource BtnSecondary}"
                            Visibility="{Binding Selected.Root, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,7,0" FontSize="13" Symbol="LockClosed24" />
                            <TextBlock VerticalAlignment="Center" Text="Abrir como root" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Wv.TextFaint}" Text="Ctrl+Shift+R" />
                </StackPanel>

                <!--  Nenhuma aba escolhida  -->
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="Escolha uma aba na barra ao lado, ou crie uma com o + do workspace."
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
