<UserControl
    x:Class="WslVision.Views.Pages.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:TerminalViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Campo de texto do design: fundo afundado, borda discreta, monoespaçado quando é caminho  -->
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{StaticResource Wv.Layer}" />
            <Setter Property="BorderBrush" Value="#26282D" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <!--  Abas e o terminal da aba atual  -->
        <DockPanel Grid.Column="0">
            <StackPanel Margin="0,0,0,14" DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource PageTitle}" Text="Terminal" />
                <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource Wv.Text2}" Text="Já dentro da distro, na pasta certa, com abas. Sem administrador." />
            </StackPanel>

            <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                <Button Height="32" Margin="8,0,0,0" Padding="10,0" AutomationProperties.Name="Nova aba de terminal" Command="{Binding OpenCommand}" DockPanel.Dock="Right"
                        Style="{StaticResource BtnGhost}" ToolTip="Nova aba na pasta escolhida ao lado">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Add24" />
                        <TextBlock VerticalAlignment="Center" Text="Nova aba" />
                    </StackPanel>
                </Button>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Sessions}" KeyboardNavigation.TabNavigation="Once">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TerminalSessionViewModel}">
                                <Border x:Name="Tab" Height="32" Margin="0,0,4,0" Padding="10,0,2,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Cursor="Hand"
                                        AutomationProperties.Name="{Binding Title}" Focusable="True" FocusVisualStyle="{StaticResource RoundFocusVisual}">
                                    <Border.InputBindings>
                                        <MouseBinding Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="LeftClick" />
                                        <MouseBinding Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MouseAction="MiddleClick" />
                                        <KeyBinding Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Key="Enter" />
                                    </Border.InputBindings>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="TabIcon" Margin="0,0,6,0" FontSize="14" Foreground="{StaticResource Wv.Text3}" Symbol="WindowConsole20" />
                                        <TextBlock x:Name="TabText" MaxWidth="180" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Wv.Text2}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        <Button Width="24" Height="24" Margin="4,0,0,0" AutomationProperties.Name="Fechar aba" Style="{StaticResource BtnIcon}" ToolTip="Fechar aba (clique do meio também fecha)"
                                                Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <ui:SymbolIcon FontSize="11" Symbol="Dismiss24" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Tab" Property="Background" Value="{StaticResource Wv.Hover}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Tab" Property="Background" Value="{StaticResource Wv.Surface}" />
                                        <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Wv.BorderStrong}" />
                                        <Setter TargetName="TabIcon" Property="Foreground" Value="{StaticResource Wv.Accent}" />
                                        <Setter TargetName="TabText" Property="Foreground" Value="{StaticResource Wv.Text}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AsRoot}" Value="True">
                                        <Setter TargetName="TabIcon" Property="Symbol" Value="LockClosed24" />
                                        <Setter TargetName="TabIcon" Property="Foreground" Value="{StaticResource Wv.Amber}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <Border Padding="10,8" ClipToBounds="True" Style="{StaticResource CardBorder}">
                <Grid>
                    <!--  Os terminais (um por aba) entram aqui pelo código; só o da aba atual fica visível  -->
                    <Grid x:Name="TermHost" />

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoSessions, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="36" Foreground="{StaticResource Wv.Text3}" Symbol="WindowConsole20" />
                        <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Nenhum terminal aberto" />
                        <TextBlock MaxWidth="420" HorizontalAlignment="Center" Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Abra um terminal da distro aqui dentro. Escolha a pasta ao lado ou rode um dos seus comandos rápidos." />
                        <Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding OpenCommand}" Style="{StaticResource BtnPrimary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Symbol="WindowConsole20" />
                                <TextBlock VerticalAlignment="Center" Text="Abrir terminal" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!--  Painel lateral: pasta da nova aba e comandos rápidos  -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <!--  Margem à direita: a barra de rolagem fica por cima do conteúdo  -->
            <StackPanel Margin="0,0,12,0">
                <!--  Abrir: pasta, quem, e um botão  -->
                <Border Margin="0,0,0,18" Padding="16" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Wv.Text2}" Text="Pasta" />
                        <DockPanel>
                            <Button Width="36" Height="36" Margin="6,0,0,0" AutomationProperties.Name="Escolher pasta" Command="{Binding BrowseCommand}" DockPanel.Dock="Right"
                                    Style="{StaticResource BtnSecondary}" Padding="0" ToolTip="Escolher pasta…">
                                <ui:SymbolIcon FontSize="15" Symbol="FolderOpen24" />
                            </Button>
                            <TextBox AutomationProperties.Name="Pasta" FontFamily="{StaticResource Wv.Mono}" Style="{StaticResource Field}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Recents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,6,6" Command="{Binding DataContext.PickRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Content="{Binding}" Style="{StaticResource BtnChip}" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" HorizontalAlignment="Stretch" Command="{Binding OpenCommand}" Style="{StaticResource BtnPrimary}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,7,0" FontSize="14" Symbol="WindowConsole20" />
                                    <TextBlock VerticalAlignment="Center" Text="Abrir terminal" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Padding="12,0" Command="{Binding OpenAsRootCommand}" Style="{StaticResource BtnSecondary}" ToolTip="Abre uma aba como root: pode alterar qualquer arquivo da distro (pede confirmação)">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" FontSize="13" Foreground="{StaticResource Wv.Amber}" Symbol="LockClosed24" />
                                    <TextBlock VerticalAlignment="Center" Text="Como root" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button Height="32" Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding OpenExternalCommand}" Style="{StaticResource BtnGhost}"
                                ToolTip="A mesma pasta, numa janela separada do Windows Terminal">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Open24" />
                                <TextBlock VerticalAlignment="Center" Text="Abrir no Windows Terminal" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!--  Comandos rápidos  -->
                <DockPanel Margin="2,0,0,10">
                    <Button Height="30" Padding="10,0" AutomationProperties.Name="Novo comando rápido" Command="{Binding ToggleFormCommand}" DockPanel.Dock="Right" Style="{StaticResource BtnGhost}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Add24" />
                            <TextBlock VerticalAlignment="Center" Text="Novo" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Comandos rápidos" />
                        <TextBlock FontSize="12" Foreground="{StaticResource Wv.Text3}" Text="Abre uma aba na pasta e roda o comando" />
                    </StackPanel>
                </DockPanel>

                <Border Margin="0,0,0,10" Padding="16,14" Background="{StaticResource Wv.Surface}" BorderBrush="{StaticResource Wv.BorderStrong}" BorderThickness="1" CornerRadius="12"
                        Visibility="{Binding ShowForm, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Wv.Text2}" Text="Nome" />
                        <ui:TextBox Margin="0,0,0,10" AutomationProperties.Name="Nome do comando" PlaceholderText="Ex.: Subir banco" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Wv.Text2}" Text="Comando" />
                        <ui:TextBox Margin="0,0,0,10" AutomationProperties.Name="Comando" FontFamily="{StaticResource Wv.Mono}" PlaceholderText="docker compose up -d db" Text="{Binding NewCommand, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Wv.Text2}" Text="Pasta" />
                        <ui:TextBox Margin="0,0,0,12" AutomationProperties.Name="Pasta do comando" FontFamily="{StaticResource Wv.Mono}" Text="{Binding NewFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding ToggleFormCommand}" Content="Cancelar" Style="{StaticResource BtnGhost}" />
                            <Button Command="{Binding AddCommandCommand}" Content="Salvar" Style="{StaticResource BtnPrimary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Commands}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuickCommandViewModel}">
                            <Border Margin="0,0,0,10" Padding="16,14,12,12" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button Width="28" Height="28" Margin="6,-4,-4,0" AutomationProperties.Name="{Binding Name, StringFormat=Remover o comando {0}}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Remover"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <ui:SymbolIcon FontSize="13" Symbol="Delete24" />
                                        </Button>
                                        <Border Height="20" Margin="8,0,0,0" Padding="7,0" VerticalAlignment="Center" Background="{StaticResource Wv.AmberSoft}" CornerRadius="10" DockPanel.Dock="Right"
                                                ToolTip="Pede a senha do sudo" Visibility="{Binding NeedsSudo, Converter={StaticResource BoolToVis}}">
                                            <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Wv.Amber}" Text="sudo" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <Border Margin="0,8,0,8" Padding="10,7" Background="{StaticResource Wv.Layer}" BorderBrush="{StaticResource Wv.Border}" BorderThickness="1" CornerRadius="7">
                                        <TextBlock FontFamily="{StaticResource Wv.Mono}" FontSize="12" Foreground="#C9CDD3" Text="{Binding Command}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                    </Border>
                                    <DockPanel>
                                        <Button Height="32" Padding="12,0" AutomationProperties.Name="{Binding Name, StringFormat=Executar {0} numa aba nova}" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" ToolTip="Executar numa aba nova"
                                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="11" Filled="True" Foreground="{StaticResource Wv.Green}" Symbol="Play24" />
                                                <TextBlock VerticalAlignment="Center" Text="Executar" />
                                            </StackPanel>
                                        </Button>
                                        <Button Width="32" Height="32" Margin="0,0,6,0" AutomationProperties.Name="{Binding Name, StringFormat=Rodar {0} na aba atual}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Rodar na aba atual"
                                                Command="{Binding DataContext.RunHereCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.HasCurrentSession, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ui:SymbolIcon FontSize="14" Symbol="Send24" />
                                        </Button>
                                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Wv.Green}" Text="Aberto"
                                                   Visibility="{Binding JustRan, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Wv.Mono}" FontSize="12" Foreground="{StaticResource Wv.Text3}" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button MinHeight="96" HorizontalAlignment="Stretch" Command="{Binding ToggleFormCommand}" Visibility="{Binding HasNoCommands, Converter={StaticResource BoolToVis}}"
                        Background="Transparent" BorderBrush="#34373D" Foreground="{StaticResource Wv.Text2}" Style="{StaticResource BtnSecondary}" Tag="{StaticResource Wv.Hover}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="18" Symbol="Add24" />
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Text="Novo comando" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Wv.Text3}" Text="Suba seu projeto com um clique" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
