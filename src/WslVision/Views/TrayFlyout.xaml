<UserControl
    x:Class="WslVision.Views.TrayFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WslVision.ViewModels"
    Width="376"
    d:DataContext="{d:DesignInstance Type=vm:TrayFlyoutViewModel}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    FontSize="14"
    Foreground="{StaticResource Wv.Text}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="MiniMeter" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{StaticResource Wv.BorderStrong}" CornerRadius="2" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource Wv.Accent}" CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepTag" TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{StaticResource Wv.Flyout}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Resources>

    <Border Margin="12" Background="{StaticResource Wv.Flyout}" BorderBrush="{StaticResource Wv.BorderStrong}" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Opacity="0.5" ShadowDepth="8" />
        </Border.Effect>
        <StackPanel>
            <!--  Marca e status  -->
            <DockPanel Margin="14,12,8,10">
                <Button Width="36" Height="36" AutomationProperties.Name="Abrir o painel" Command="{Binding OpenPanelCommand}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Abrir o painel">
                    <ui:SymbolIcon FontSize="16" Symbol="Open24" />
                </Button>
                <Image Width="24" Height="24" Margin="0,0,10,0" DockPanel.Dock="Left" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Assets/logo.png" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13"><Run FontWeight="Bold" Text="WSL" /><Run FontWeight="Medium" Text=" Vision" /></TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource Wv.Text2}" Text="{Binding Env.Detail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!--  Estado + a ação principal  -->
            <Border Margin="10,0" Padding="14" Background="#212327" CornerRadius="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse Fill="{Binding Env.Tone, Converter={StaticResource ToneHalo}}" />
                            <Ellipse Width="9" Height="9" Fill="{Binding Env.Tone, Converter={StaticResource ToneBrush}}" />
                        </Grid>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Env.Title}" />
                    </StackPanel>
                    <WrapPanel Margin="0,12,0,12">
                        <Border Style="{StaticResource StepTag}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding Env.Distro.Tone, Converter={StaticResource ToneBrush}}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource Wv.TextSoft}" Text="Distro" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StepTag}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding Env.Docker.Tone, Converter={StaticResource ToneBrush}}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource Wv.TextSoft}" Text="Docker" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StepTag}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding Env.Projects.Tone, Converter={StaticResource ToneBrush}}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource Wv.TextSoft}" Text="{Binding Env.Projects.Value, StringFormat=Projetos {0}}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <Button Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding Env.StopCommand}" Style="{StaticResource BtnSecondary}"
                            Visibility="{Binding Env.IsOn, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,8,0" FontSize="13" Filled="True" Symbol="Stop24" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Parar ambiente" />
                        </StackPanel>
                    </Button>
                    <Button Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding Env.StartCommand}" Style="{StaticResource BtnPrimary}"
                            Visibility="{Binding Env.IsOff, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,8,0" FontSize="13" Filled="True" Symbol="Play24" />
                            <TextBlock VerticalAlignment="Center" Text="Iniciar ambiente" />
                        </StackPanel>
                    </Button>
                    <Border Height="38" Background="{StaticResource Wv.Flyout}" CornerRadius="8" Visibility="{Binding Env.IsStarting, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="{Binding Env.IsStarting}" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Wv.Text2}" Text="{Binding Env.State.EnvironmentStep}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Consumo  -->
            <Grid Margin="10,12,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="10,8" Background="#212327" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource Wv.Text2}" Text="Memória" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding MemText}" />
                        <ProgressBar Style="{StaticResource MiniMeter}" Value="{Binding MemPercent, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="10,8" Background="#212327" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource Wv.Text2}" Text="CPU" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding CpuText}" />
                        <ProgressBar Style="{StaticResource MiniMeter}" Value="{Binding CpuPercent, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Padding="10,8" Background="#212327" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource Wv.Text2}" Text="No Windows" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding VmmemText}" />
                        <ProgressBar Style="{StaticResource MiniMeter}" Value="{Binding VmmemPercent, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Projetos  -->
            <StackPanel Margin="10,10,10,6" Visibility="{Binding Inventory.Groups.Count, Converter={StaticResource NonZeroToVis}}">
                <TextBlock Margin="4,0,0,4" Style="{StaticResource SectionLabel}" Text="PROJETOS" />
                <ItemsControl ItemsSource="{Binding Inventory.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ContainerGroupViewModel}">
                            <DockPanel MinHeight="44" Margin="4,0">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left" Fill="{Binding Status, Converter={StaticResource ToneBrush}}" />
                                <Button Height="30" Margin="6,0,0,0" DockPanel.Dock="Right" FontSize="12"
                                        Command="{Binding DataContext.Inventory.ToggleGroupRunningCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource BtnSecondary}" TargetType="Button">
                                            <Setter Property="Content" Value="Iniciar" />
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Title, StringFormat=Iniciar {0}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AnyRunning}" Value="True">
                                                    <Setter Property="Content" Value="Parar" />
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title, StringFormat=Parar {0}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Width="34" Height="34" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Terminal na pasta"
                                        AutomationProperties.Name="{Binding Title, StringFormat=Terminal em {0}}"
                                        Command="{Binding DataContext.OpenProjectTerminalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding HasWorkingDir, Converter={StaticResource BoolToVis}}">
                                    <ui:SymbolIcon FontSize="15" Symbol="WindowConsole20" />
                                </Button>
                                <Button Width="34" Height="34" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Abrir no VS Code"
                                        AutomationProperties.Name="{Binding Title, StringFormat=Abrir {0} no VS Code}"
                                        Command="{Binding DataContext.OpenProjectInVsCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding HasWorkingDir, Converter={StaticResource BoolToVis}}">
                                    <ui:SymbolIcon FontSize="14" Symbol="Code24" />
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="13" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource Wv.Text3}" Text="{Binding StatusLabel}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Workspaces do Terminal  -->
            <StackPanel Margin="10,4,10,6" Visibility="{Binding Terminal.Groups.Count, Converter={StaticResource NonZeroToVis}}">
                <TextBlock Margin="4,0,0,4" Style="{StaticResource SectionLabel}" Text="WORKSPACES" />
                <ItemsControl ItemsSource="{Binding Terminal.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WorkspaceGroupViewModel}">
                            <DockPanel MinHeight="44" Margin="4,0">
                                <Border Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Background="{Binding Brush}" CornerRadius="2" DockPanel.Dock="Left" />
                                <Grid Margin="6,0,0,0" DockPanel.Dock="Right">
                                    <Button Height="30" AutomationProperties.Name="{Binding Name, StringFormat=Iniciar o workspace {0}}" Content="Iniciar" FontSize="12" Style="{StaticResource BtnSecondary}"
                                            Command="{Binding DataContext.StartWorkspaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            ToolTip="Abre a janela no Terminal e sobe o workspace" Visibility="{Binding AnyRunning, Converter={StaticResource InverseBoolToVis}}" />
                                    <Button Height="30" AutomationProperties.Name="{Binding Name, StringFormat=Parar o workspace {0}}" Content="Parar" FontSize="12" Style="{StaticResource BtnSecondary}"
                                            Command="{Binding DataContext.StopWorkspaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            ToolTip="Ctrl+C nas abas" Visibility="{Binding AnyRunning, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <Button Width="34" Height="34" AutomationProperties.Name="{Binding Name, StringFormat=Abrir o workspace {0}}" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Abrir no Terminal"
                                        Command="{Binding DataContext.OpenWorkspaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <ui:SymbolIcon FontSize="15" Symbol="WindowConsole20" />
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource Wv.Text3}" Text="{Binding Summary}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Rodapé  -->
            <Border Margin="0,6,0,0" Padding="8,6,8,8" BorderBrush="#26282D" BorderThickness="0,1,0,0">
                <!--  Rows=1: as colunas contam só os botões visíveis (Desligar some com o WSL já desligado)  -->
                <UniformGrid Rows="1">
                    <Button Height="36" HorizontalAlignment="Stretch" Command="{Binding OpenTerminalCommand}" FontSize="12" Style="{StaticResource BtnGhost}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="WindowConsole20" />
                            <TextBlock VerticalAlignment="Center" Text="Terminal" />
                        </StackPanel>
                    </Button>
                    <Button Height="36" HorizontalAlignment="Stretch" Command="{Binding ShutdownWslCommand}" FontSize="12" Style="{StaticResource BtnGhost}"
                            Visibility="{Binding Env.State.IsDistroRunning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Power24" />
                            <TextBlock VerticalAlignment="Center" Text="Desligar WSL" />
                        </StackPanel>
                    </Button>
                    <Button Height="36" HorizontalAlignment="Stretch" Command="{Binding ExitCommand}" Content="Sair" FontSize="12" Style="{StaticResource BtnGhost}" />
                </UniformGrid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
