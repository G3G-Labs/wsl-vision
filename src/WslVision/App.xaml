<Application
    x:Class="WslVision.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Cores do WPF-UI trocadas pela paleta do WSL Vision. Ficam aqui (e não num dicionário mesclado)
                porque recursos diretos do App vencem qualquer dicionário, inclusive o tema que o WPF-UI reaplica.
            -->
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0F1012" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#131416" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#17181B" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1A1C1F" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#222428" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#222428" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1F2125" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#25282C" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#1A1C1F" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#131416" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2E3136" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#2E3136" />
            <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#4A4E55" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1C1E21" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1A1C1F" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0F1012" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#1A1B1E" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#ECEEF1" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A1A7B0" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#858B94" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#6CC7FF" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#5FD38A" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#1C2B22" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F0B13B" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#2B2417" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF8A80" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#2D1E1D" />
            <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#6B7079" />
            <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#222428" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#16283A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
