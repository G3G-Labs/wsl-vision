<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Símbolo da G3G Labs, em vetor (fica nítido em qualquer escala). Quatro peças com degradê num quadrado 100 × 100;
        o "G" é o espaço vazio no meio, então fica transparente e assume o fundo do cartão.
    -->
    <DrawingImage x:Key="G3GMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 L50,0 L0,50 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,0.6">
                            <GradientStop Offset="0" Color="#F8CF1F" />
                            <GradientStop Offset="1" Color="#F4A11A" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M50,0 L100,0 L100,50 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0" Color="#4979C0" />
                            <GradientStop Offset="0.45" Color="#13AFD5" />
                            <GradientStop Offset="1" Color="#15B3A5" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,50 L0,100 L50,100 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0" Color="#4979C0" />
                            <GradientStop Offset="0.5" Color="#13AFD5" />
                            <GradientStop Offset="1" Color="#16B5A6" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M50,50 L100,50 L100,100 L50,100 L75,75 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0" Color="#F9C51B" />
                            <GradientStop Offset="0.45" Color="#F39C1F" />
                            <GradientStop Offset="1" Color="#E9473F" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
