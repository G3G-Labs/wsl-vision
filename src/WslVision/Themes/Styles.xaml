<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:WslVision.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:NotNullConverter x:Key="NotNull" />
    <conv:ToneBrushConverter x:Key="ToneBrush" />
    <conv:ToneBrushConverter x:Key="ToneHalo" Part="Halo" />
    <conv:ToneBrushConverter x:Key="ToneSoft" Part="Soft" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    <conv:ZeroToVisibilityConverter x:Key="NonZeroToVis" Invert="True" />
    <conv:AllEqualConverter x:Key="AllEqual" />

    <!--  Moldura de foco só para teclado (Tab), com cantos arredondados  -->
    <Style x:Key="RoundFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="#6CC7FF" BorderThickness="2" CornerRadius="6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Tipografia  -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Wv.Text}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Wv.Text}" />
    </Style>
    <!--  Rótulo curto em caixa alta acima de grupos ("FAVORITOS", "AMBIENTE · DEBIAN")  -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Wv.Text3}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>
    <Style x:Key="Metric" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Wv.Text}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Wv.Text3}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!--  Superfícies  -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Wv.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Wv.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <!--  Bloco interno de um cartão (ex.: estado do ambiente na bandeja)  -->
    <Style x:Key="InsetBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Wv.Inset}" />
        <Setter Property="BorderBrush" Value="#26282D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!--
        Botões do redesign. Templates próprios (e não os do WPF-UI) para os cantos, cores e alturas
        baterem com o design: Primário (azul, uma ação por tela), Secundário (contorno), Fantasma (texto) e Ícone.
    -->
    <Style x:Key="WvButtonBase" TargetType="ButtonBase">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocusVisual}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        <Setter Property="Background" Value="{StaticResource Wv.Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Wv.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Wv.Text}" />
        <Setter Property="Tag" Value="{StaticResource Wv.HoverStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border
                        x:Name="Bg"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BtnSecondary" BasedOn="{StaticResource WvButtonBase}" TargetType="ButtonBase">
        <Setter Property="Tag" Value="#2A2D32" />
    </Style>
    <Style x:Key="BtnPrimary" BasedOn="{StaticResource WvButtonBase}" TargetType="ButtonBase">
        <Setter Property="Background" Value="{StaticResource Wv.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Wv.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Tag" Value="{StaticResource Wv.AccentHover}" />
    </Style>
    <!--  Ações destrutivas (limpar, desfazer tudo): vermelho suave, para não competir com a ação principal  -->
    <Style x:Key="BtnDanger" BasedOn="{StaticResource WvButtonBase}" TargetType="ButtonBase">
        <Setter Property="Background" Value="{StaticResource Wv.RedSoft}" />
        <Setter Property="BorderBrush" Value="#4A2C2A" />
        <Setter Property="Foreground" Value="{StaticResource Wv.Red}" />
        <Setter Property="Tag" Value="#3A2523" />
    </Style>
    <Style x:Key="BtnGhost" BasedOn="{StaticResource WvButtonBase}" TargetType="ButtonBase">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Wv.TextSoft}" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style x:Key="BtnIcon" BasedOn="{StaticResource BtnGhost}" TargetType="ButtonBase">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Wv.Text2}" />
    </Style>
    <!--  Pílula clicável (pastas recentes)  -->
    <Style x:Key="BtnChip" BasedOn="{StaticResource WvButtonBase}" TargetType="ButtonBase">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource Wv.Mono}" />
        <Setter Property="Background" Value="{StaticResource Wv.Inset}" />
        <Setter Property="BorderBrush" Value="#2A2D32" />
        <Setter Property="Foreground" Value="{StaticResource Wv.TextSoft}" />
        <Setter Property="Tag" Value="#2A2D32" />
    </Style>
    <Style x:Key="EmptyState" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Padding" Value="24,56" />
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--  Selo de status: as cores vêm do tema (DynamicResource), então acompanham claro/escuro em tempo real.
         Funciona para containers e grupos: ambos expõem Status e StatusLabel.  -->
    <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Error">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Restarting">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Partial">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Paused">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="Dot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Item do menu lateral: ícone + rótulo, com o indicador azul do Windows 11  -->
    <Style x:Key="NavRailItem" TargetType="RadioButton">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocusVisual}" />
        <Setter Property="Foreground" Value="#A1A7B0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border
                            x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="8" />
                        <Border
                            x:Name="Indicator"
                            Width="3"
                            Height="20"
                            Margin="-6,0,0,0"
                            HorizontalAlignment="Left"
                            Background="#4CC2FF"
                            CornerRadius="2"
                            Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1C1E21" />
                            <Setter Property="Foreground" Value="#ECEEF1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1C1E21" />
                            <Setter Property="Foreground" Value="#ECEEF1" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Botões segmentados (filtros)  -->
    <Style x:Key="SegmentItem" TargetType="RadioButton">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocusVisual}" />
        <Setter Property="Foreground" Value="#A1A7B0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Bg"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1F2125" />
                            <Setter Property="Foreground" Value="#ECEEF1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2A2D32" />
                            <Setter Property="Foreground" Value="#ECEEF1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Linha de lista sem o destaque azul padrão; a seleção usa um fundo sutil  -->
    <Style x:Key="PlainListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Bg"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PlainListItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" CanContentScroll="True">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
