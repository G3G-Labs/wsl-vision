<!--
    Paleta do WSL Vision (tema escuro). Os nomes Wv.* são usados pelas telas; as chaves do WPF-UI
    são redefinidas no App.xaml com estes mesmos valores, para que os controles prontos combinem.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Superfícies, da mais funda para a mais alta  -->
    <Color x:Key="Wv.BgColor">#0F1012</Color>
    <Color x:Key="Wv.LayerColor">#131416</Color>
    <Color x:Key="Wv.SurfaceColor">#17181B</Color>
    <Color x:Key="Wv.RaisedColor">#1F2125</Color>
    <Color x:Key="Wv.FlyoutColor">#1A1B1E</Color>
    <SolidColorBrush x:Key="Wv.Bg" Color="{StaticResource Wv.BgColor}" />
    <SolidColorBrush x:Key="Wv.Layer" Color="{StaticResource Wv.LayerColor}" />
    <SolidColorBrush x:Key="Wv.Surface" Color="{StaticResource Wv.SurfaceColor}" />
    <SolidColorBrush x:Key="Wv.Raised" Color="{StaticResource Wv.RaisedColor}" />
    <SolidColorBrush x:Key="Wv.Flyout" Color="{StaticResource Wv.FlyoutColor}" />
    <SolidColorBrush x:Key="Wv.Inset" Color="#1D1F23" />
    <SolidColorBrush x:Key="Wv.Track" Color="#24262A" />

    <!--  Bordas e divisores  -->
    <SolidColorBrush x:Key="Wv.Border" Color="#222428" />
    <SolidColorBrush x:Key="Wv.BorderStrong" Color="#2E3136" />
    <SolidColorBrush x:Key="Wv.Divider" Color="#1F2124" />

    <!--  Estados de interação  -->
    <SolidColorBrush x:Key="Wv.Hover" Color="#1A1C1F" />
    <SolidColorBrush x:Key="Wv.HoverStrong" Color="#22252A" />
    <SolidColorBrush x:Key="Wv.Selected" Color="#1D2228" />
    <SolidColorBrush x:Key="Wv.NavSelected" Color="#1C1E21" />

    <!--  Texto (todos passam de 4,5:1 sobre Wv.Surface)  -->
    <SolidColorBrush x:Key="Wv.Text" Color="#ECEEF1" />
    <SolidColorBrush x:Key="Wv.TextSoft" Color="#C9CDD3" />
    <SolidColorBrush x:Key="Wv.Text2" Color="#A1A7B0" />
    <SolidColorBrush x:Key="Wv.Text3" Color="#858B94" />
    <SolidColorBrush x:Key="Wv.TextFaint" Color="#5F646C" />

    <!--  Destaque único do produto  -->
    <Color x:Key="Wv.AccentColor">#4CC2FF</Color>
    <SolidColorBrush x:Key="Wv.Accent" Color="{StaticResource Wv.AccentColor}" />
    <SolidColorBrush x:Key="Wv.AccentHover" Color="#7AD3FF" />
    <SolidColorBrush x:Key="Wv.AccentText" Color="#6CC7FF" />
    <SolidColorBrush x:Key="Wv.OnAccent" Color="#06263A" />

    <!--  Status: sempre acompanhados de texto, nunca só a cor  -->
    <SolidColorBrush x:Key="Wv.Green" Color="#5FD38A" />
    <SolidColorBrush x:Key="Wv.GreenSoft" Color="#1C2B22" />
    <SolidColorBrush x:Key="Wv.GreenHalo" Color="#2E5FD38A" />
    <SolidColorBrush x:Key="Wv.Amber" Color="#F0B13B" />
    <SolidColorBrush x:Key="Wv.AmberSoft" Color="#2B2417" />
    <SolidColorBrush x:Key="Wv.AmberText" Color="#F3D08A" />
    <SolidColorBrush x:Key="Wv.AmberHalo" Color="#2EF0B13B" />
    <SolidColorBrush x:Key="Wv.Red" Color="#FF8A80" />
    <SolidColorBrush x:Key="Wv.RedSoft" Color="#2D1E1D" />
    <SolidColorBrush x:Key="Wv.RedHalo" Color="#2EFF8A80" />
    <SolidColorBrush x:Key="Wv.Gray" Color="#6B7079" />
    <SolidColorBrush x:Key="Wv.GraySoft" Color="#222428" />
    <SolidColorBrush x:Key="Wv.GrayHalo" Color="#2E6B7079" />
    <SolidColorBrush x:Key="Wv.Folder" Color="#E6B34F" />

    <!--  Fontes  -->
    <FontFamily x:Key="Wv.Mono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
